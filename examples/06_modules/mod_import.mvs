/*
 * mod.mvs directory modules (like Rust's mod.rs)
 *
 * When "use self::mypack" and mypack.mvs does not exist,
 * the compiler looks for mypack/mod.mvs instead.
 * mod.mvs can re-export from submodules with pub use.
 */
use std::io;
use self::mypack::{hello, goodbye};
use self::mypack::{add, mul};

func main() -> i8 {
    io.out("{}", hello());
    io.out("{}", goodbye());
    io.out("2 + 3 = {}", add(2, 3));
    io.out("4 * 5 = {}", mul(4, 5));
    return 0;
}
