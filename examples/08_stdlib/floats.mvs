// ============================================================
//  floats — เลขทศนิยม f32/f64 (เลขคณิต, เปรียบเทียบ, เรียก C math)
//  build:  mvs.exe examples/08_stdlib/floats.mvs
//  run:    examples\08_stdlib\floats.exe
// ============================================================
import { io } from "std";
extern func sqrt(x: f64) -> f64;     // จาก C math (ลิงก์อยู่กับ CRT)

func circleArea(r: f64) -> f64 { return 3.14159 * r * r; }

func main() -> i8 {
    let r: f64 = 2.0;
    io.out("area(r=2) = {}", circleArea(r));   // 12.566360
    io.out("3.0 / 2.0 = {}", 3.0 / 2.0);       // 1.5
    io.out("2.0 ** 10 = {}", 2.0 ** 10);       // 1024.0 (ยกกำลังฐานทศนิยม)
    io.out("mixed 1.5 + 2 = {}", 1.5 + 2);     // 3.5 (int -> float อัตโนมัติ)
    io.out("sqrt(144) = {}", sqrt(144.0));     // 12.0 (เรียก C math)
    io.out("-3.5 (unary minus) = {}", 0.0 - 3.5 - (3.5 - 3.5)); // -3.5
    return 0;
}
