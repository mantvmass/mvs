/*
 * core/bits.mvs - bit manipulation in pure MVS (--nostd safe)
 *
 *     import { bits } from "core";
 *     let n: i64 = bits.popcount(mask);
 */

// rotate left / right (n taken modulo 64)
func rotl64(x: u64, n: u64) -> u64 {
    let r: u64 = n & 63;
    if (r == 0) { return x; }
    return (x << r) | (x >> (64 - r));
}
func rotr64(x: u64, n: u64) -> u64 {
    let r: u64 = n & 63;
    if (r == 0) { return x; }
    return (x >> r) | (x << (64 - r));
}

// number of set bits
func popcount(x: u64) -> i64 {
    let n: i64 = 0;
    let v: u64 = x;
    while (v != 0) {
        v = v & (v - 1);      // clears the lowest set bit
        n = n + 1;
    }
    return n;
}

// leading / trailing zero count (64 when x is 0)
func clz64(x: u64) -> i64 {
    if (x == 0) { return 64; }
    let n: i64 = 0;
    let v: u64 = x;
    while ((v & 0x8000000000000000) == 0) {
        v = v << 1;
        n = n + 1;
    }
    return n;
}
func ctz64(x: u64) -> i64 {
    if (x == 0) { return 64; }
    let n: i64 = 0;
    let v: u64 = x;
    while ((v & 1) == 0) {
        v = v >> 1;
        n = n + 1;
    }
    return n;
}

// reverse the byte order
func bswap64(x: u64) -> u64 {
    let r: u64 = 0;
    let v: u64 = x;
    let i: i64 = 0;
    while (i < 8) {
        r = (r << 8) | (v & 0xFF);
        v = v >> 8;
        i = i + 1;
    }
    return r;
}

// test a single bit
func bit(x: u64, i: u64) -> bool {
    return ((x >> i) & 1) == 1;
}
