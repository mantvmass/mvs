// ============================================================
//  net_client: Rust-style TCP client (struct + method chaining, cross-platform sockets)
//  build:  mvs.exe examples/08_stdlib/net_client.mvs
//  run:    examples\08_stdlib\net_client.exe   (requires a reachable server)
// ============================================================
import { io, net } from "std";

func main() -> i8 {
    let conn: TcpSocket = TcpSocket::connect("93.184.216.34", 80);  // example.com
    conn.send("GET / HTTP/1.0\r\nHost: example.com\r\n\r\n");
    let reply: str = conn.recv();
    io.out("server replied:\n{}", reply);
    conn.close();
    return 0;
}
