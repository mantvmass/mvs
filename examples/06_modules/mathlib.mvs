// ============================================================
//  mathlib: a user-written module (imported by use_import.mvs)
//  no standalone build needed; it is imported by another file
// ============================================================

func square(x: i32) -> i32 { return x * x; }

func factorial(n: i32) -> i32 {
    let r: i32 = 1;
    for (let i: i32 = 1; i <= n; i++) { r = r * i; }
    return r;
}
