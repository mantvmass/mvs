/*
 * std/math.mvs - basic math functions
 *
 * Thin wrappers over libm (sqrt/pow/...) plus pure MVS integer helpers.
 * Integer and float variants share names through function overloading.
 *
 * Example:
 *     use std::{io, math};
 *     io.out("{}", math.sqrt(2.0));
 *     io.out("{}", math.abs(0 - 5));
 *     io.out("{}", math.clamp(12, 0, 10));
 */

// --- foreign functions from libm / the C runtime ---
extern func sqrt(x: f64) -> f64;
extern func pow(base: f64, exp: f64) -> f64;
extern func floor(x: f64) -> f64;
extern func ceil(x: f64) -> f64;
extern func round(x: f64) -> f64;
extern func fabs(x: f64) -> f64;
extern func fmod(a: f64, b: f64) -> f64;
extern func sin(x: f64) -> f64;
extern func cos(x: f64) -> f64;
extern func tan(x: f64) -> f64;
extern func asin(x: f64) -> f64;
extern func acos(x: f64) -> f64;
extern func atan(x: f64) -> f64;
extern func atan2(y: f64, x: f64) -> f64;
extern func log(x: f64) -> f64;
extern func log2(x: f64) -> f64;
extern func log10(x: f64) -> f64;
extern func exp(x: f64) -> f64;
extern func exp2(x: f64) -> f64;

// mathematical constants (as functions; module-level constants stay local to std)
func pi() -> f64 { return 3.141592653589793; }
func e() -> f64 { return 2.718281828459045; }

// absolute value
func abs(x: i64) -> i64 {
    if (x < 0) { return 0 - x; }
    return x;
}
func abs(x: f64) -> f64 { return fabs(x); }

// smaller / larger of two values
func min(a: i64, b: i64) -> i64 {
    if (a < b) { return a; }
    return b;
}
func min(a: f64, b: f64) -> f64 {
    if (a < b) { return a; }
    return b;
}
func max(a: i64, b: i64) -> i64 {
    if (a > b) { return a; }
    return b;
}
func max(a: f64, b: f64) -> f64 {
    if (a > b) { return a; }
    return b;
}

// clamp x into the range [lo, hi]
func clamp(x: i64, lo: i64, hi: i64) -> i64 {
    if (x < lo) { return lo; }
    if (x > hi) { return hi; }
    return x;
}
func clamp(x: f64, lo: f64, hi: f64) -> f64 {
    if (x < lo) { return lo; }
    if (x > hi) { return hi; }
    return x;
}

// sign of x as -1, 0, or 1
func sign(x: i64) -> i64 {
    if (x < 0) { return 0 - 1; }
    if (x > 0) { return 1; }
    return 0;
}

// greatest common divisor (Euclid), always non-negative
func gcd(a: i64, b: i64) -> i64 {
    let x: i64 = abs(a);
    let y: i64 = abs(b);
    while (y != 0) {
        let t: i64 = y;
        y = x % y;
        x = t;
    }
    return x;
}

// least common multiple (0 when either input is 0)
func lcm(a: i64, b: i64) -> i64 {
    if (a == 0 || b == 0) { return 0; }
    return abs(a / gcd(a, b) * b);
}

// integer exponentiation by squaring (exp < 0 returns 0, like integer division)
func ipow(base: i64, exp: i64) -> i64 {
    if (exp < 0) { return 0; }
    let result: i64 = 1;
    let b: i64 = base;
    let n: i64 = exp;
    while (n > 0) {
        if (n % 2 == 1) { result = result * b; }
        b = b * b;
        n = n / 2;
    }
    return result;
}

// trigonometric and log/exp: the extern declarations above are accessible as
// math.sin(), math.cos(), math.log(), math.exp(), etc. through the namespace.
// ln is an alias for the C log() function (a more familiar name for some users).
func ln(x: f64) -> f64 { return log(x); }

// the hypotenuse without overflow: sqrt(a*a + b*b)
func hypot(a: f64, b: f64) -> f64 { return sqrt(a * a + b * b); }

// convert degrees to radians and back
func to_radians(deg: f64) -> f64 { return deg * 3.141592653589793 / 180.0; }
func to_degrees(rad: f64) -> f64 { return rad * 180.0 / 3.141592653589793; }

// IEEE classification: NaN is the only value not equal to itself
func is_nan(x: f64) -> bool { return x != x; }

// infinity: value larger than any finite number
func is_inf(x: f64) -> bool {
    if (x != x) { return false; }
    return x - x != 0.0;
}

func is_finite(x: f64) -> bool {
    return !is_nan(x) && !is_inf(x);
}
