// Atomic operations: lock-free counter incremented from multiple threads
use std::{io, thread};
use core::atomic;

let counter: i64 = 0;
let done_count: i64 = 0;

func worker(arg: *u8) -> *u8 {
    let n: i64 = *(arg as *i64);
    let i: i64 = 0;
    while (i < n) {
        atomic.add(&counter, 1);
        i = i + 1;
    }
    atomic.add(&done_count, 1);
    return 0;
}

func main() -> i8 {
    let iters: i64 = 10000;

    let t1: usize = thread.spawn(worker, &iters as *u8);
    let t2: usize = thread.spawn(worker, &iters as *u8);
    let t3: usize = thread.spawn(worker, &iters as *u8);
    let t4: usize = thread.spawn(worker, &iters as *u8);

    thread.join(t1);
    thread.join(t2);
    thread.join(t3);
    thread.join(t4);

    io.out("4 threads x {} iterations\n", iters);
    io.out("counter = {} (expected {})\n", counter, iters * 4);
    io.out("done = {}\n", done_count);

    // CAS test: swap 40000 to 99 only if it is still 40000
    let old: i64 = atomic.cas(&counter, iters * 4, 99);
    io.out("cas {}->99: old = {}, now = {}\n", iters * 4, old, counter);

    // exchange test: unconditionally swap and get the old value
    let prev: i64 = atomic.exchange(&counter, 42);
    io.out("exchange: prev = {}, now = {}\n", prev, counter);

    return 0;
}
