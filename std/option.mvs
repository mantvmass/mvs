/*
 * std/option.mvs - Option<T>: a value that may be absent (a TRUE Rust-style enum)
 *
 * Usage:
 *     import { Option, Some, None } from "std/option";
 *
 *     func find(...) -> Option<i64> {
 *         if (found) { return Some(i); }    // T inferred from the argument
 *         return None<i64>();               // nothing to infer: explicit
 *     }
 *
 *     let r: Option<i64> = find(...);
 *     match (r) {                           // bare Rust-style patterns work
 *         Some(v) => { io.out("found {}", v); }
 *         None => { io.out("missing"); }
 *     }
 *
 * The methods (is_some/unwrap/unwrap_or) remain for pipeline style.
 * Variant order is part of the representation: None = 0, Some = 1.
 */

extern func printf(fmt: str) -> i32;
extern func exit(code: i32) -> void;

enum Option<T> {
    None,
    Some(T),
}

impl Option<T> {
    // does this Option hold a value?
    func is_some(self: *Option<T>) -> bool { return self.__tag == 1; }
    func is_none(self: *Option<T>) -> bool { return self.__tag == 0; }

    // the value; aborts the program when there is none
    func unwrap(self: *Option<T>) -> T {
        if (self.__tag == 0) {
            printf("panic: called unwrap() on a None value\n");
            exit(1);
        }
        return self.v1_0;
    }

    // the value, or the fallback when there is none
    func unwrap_or(self: *Option<T>, fallback: T) -> T {
        if (self.__tag == 1) { return self.v1_0; }
        return fallback;
    }
}

// a present value (T inferred from the argument)
func Some<T>(v: T) -> Option<T> {
    return Option<T>::Some(v);
}

// an absent value (give T explicitly: None<i64>())
func None<T>() -> Option<T> {
    return Option<T>::None;
}
