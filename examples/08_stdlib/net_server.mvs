// ============================================================
//  net_server: Rust-style TCP echo server (struct + method, cross-platform sockets)
//  build:  mvs.exe examples/08_stdlib/net_server.mvs
//  run:    examples\08_stdlib\net_server.exe
//  test:   open another terminal -> curl http://127.0.0.1:8080/
// ============================================================
import { io, net } from "std";

func main() -> i8 {
    let server: TcpServer = net.TcpServer("0.0.0.0", 8080);  // wait on port 8080
    io.out("listening on port 8080 ...");

    let conn: TcpSocket = server.accept();   // accept one connection
    let request: str = conn.recv();
    io.out("got request:\n{}", request);

    conn.send("HTTP/1.0 200 OK\r\nContent-Type: text/plain\r\n\r\nHello from MVS server!\n");
    conn.close();
    server.close();
    return 0;
}
