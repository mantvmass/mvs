// @compile(...): conditional compilation per target OS / architecture.
// Exactly ONE definition of each function below survives per target; if the
// attribute filtering failed, the compiler would reject the duplicates.
// Every variant prints the same text so the golden output is target-independent.
import { io } from "std";

@compile(target_os = "windows")
func os_pick() -> str { return "one os variant kept"; }

@compile(target_os = "linux")
func os_pick() -> str { return "one os variant kept"; }

@compile(target_arch = "x86_64")
func arch_pick() -> str { return "one arch variant kept"; }

@compile(target_arch = "aarch64")
func arch_pick() -> str { return "one arch variant kept"; }

// both keys on one item = AND: kept only when os AND arch match
@compile(target_os = "windows", target_arch = "x86_64")
func pair_pick() -> i32 { return 7; }
@compile(target_os = "linux", target_arch = "x86_64")
func pair_pick() -> i32 { return 7; }
@compile(target_os = "linux", target_arch = "aarch64")
func pair_pick() -> i32 { return 7; }

// attributes also gate globals, structs, and impl blocks
@compile(target_os = "windows")
const WIDTH: i32 = 80;
@compile(target_os = "linux")
const WIDTH: i32 = 80;

// not(...) combinator: match everything EXCEPT the named target
@compile(not(target_os = "linux"))
func not_linux() -> str { return "not linux"; }
@compile(not(target_os = "windows"))
func not_linux() -> str { return "not linux"; }

func main() -> i8 {
    io.out("{}", os_pick());
    io.out("{}", arch_pick());
    io.out("pair = {}", pair_pick());
    io.out("width = {}", WIDTH);
    io.out("{}", not_linux());

    // block-level @compile inside a function body
    let tag: str = "none";
    @compile(target_os = "windows") {
        tag = "win block";
    }
    @compile(target_os = "linux") {
        tag = "win block";
    }
    io.out("{}", tag);

    // not(...) in a block
    let neg: str = "fallback";
    @compile(not(target_arch = "aarch64")) {
        neg = "not aarch64";
    }
    @compile(target_arch = "aarch64") {
        neg = "not aarch64";
    }
    io.out("{}", neg);

    // nested @compile blocks: outer gates OS, inner gates arch
    let nested: str = "miss";
    @compile(target_os = "windows") {
        @compile(target_arch = "x86_64") {
            nested = "nested ok";
        }
    }
    @compile(target_os = "linux") {
        @compile(target_arch = "x86_64") {
            nested = "nested ok";
        }
        @compile(target_arch = "aarch64") {
            nested = "nested ok";
        }
    }
    io.out("{}", nested);

    // --- axis: @compile blocks in every control-flow context ---

    // inside if body
    let in_if: str = "miss";
    if (true) {
        @compile(target_os = "windows") {
            in_if = "if ok";
        }
        @compile(target_os = "linux") {
            in_if = "if ok";
        }
    }
    io.out("{}", in_if);

    // inside else body
    let in_else: str = "miss";
    if (false) {
        in_else = "wrong";
    } else {
        @compile(target_os = "windows") {
            in_else = "else ok";
        }
        @compile(target_os = "linux") {
            in_else = "else ok";
        }
    }
    io.out("{}", in_else);

    // inside elseif body (3-level chain: the exact bug pattern we fixed)
    let in_elseif: str = "miss";
    if (false) {
        in_elseif = "wrong";
    } else if (false) {
        in_elseif = "wrong";
    } else if (true) {
        @compile(target_os = "windows") {
            in_elseif = "elseif ok";
        }
        @compile(target_os = "linux") {
            in_elseif = "elseif ok";
        }
    } else {
        in_elseif = "wrong";
    }
    io.out("{}", in_elseif);

    // inside while body
    let in_while: str = "miss";
    let i: i32 = 0;
    while (i < 1) {
        @compile(target_os = "windows") {
            in_while = "while ok";
        }
        @compile(target_os = "linux") {
            in_while = "while ok";
        }
        i = i + 1;
    }
    io.out("{}", in_while);

    // inside for body
    let in_for: str = "miss";
    for (let j: i32 = 0; j < 1; j = j + 1) {
        @compile(target_os = "windows") {
            in_for = "for ok";
        }
        @compile(target_os = "linux") {
            in_for = "for ok";
        }
    }
    io.out("{}", in_for);

    // non-matching @compile block is removed (no dead code emitted)
    let removed: str = "removed ok";
    @compile(target_os = "windows") {
        @compile(not(target_os = "windows")) {
            removed = "FAIL";
        }
    }
    @compile(target_os = "linux") {
        @compile(not(target_os = "linux")) {
            removed = "FAIL";
        }
    }
    io.out("{}", removed);

    return 0;
}
