/*
 * std/fs.mvs - the fs (filesystem) module of the standard library, written in MVS
 *
 * Uses foreign functions from the C runtime (fopen/fputs/fgets/fclose)
 * Usage:
 *     import { fs } from "std";
 *     fs.write("out.txt", "hello");
 *     let s: str = fs.read("out.txt");
 */

extern func fopen(path: str, mode: str) -> *u8;     // returns FILE* (as a pointer)
extern func fputs(s: str, stream: *u8) -> i32;
extern func fgets(buf: *u8, n: i32, stream: *u8) -> *u8;
extern func fclose(stream: *u8) -> i32;
extern func malloc(n: usize) -> *u8;

// write a string to a file (overwrite); returns 0 on success, -1 if the file cannot be opened
func write(path: str, content: str) -> i32 {
    let f: *u8 = fopen(path, "w");
    if (f == 0) {
        return -1;
    }
    fputs(content, f);
    fclose(f);
    return 0;
}

// read a file (first line, up to ~4095 bytes) as a string; returns "" if the file cannot be opened
func read(path: str) -> str {
    let f: *u8 = fopen(path, "r");
    if (f == 0) {
        return "";
    }
    let buf: *u8 = malloc(4096);
    fgets(buf, 4096, f);
    fclose(f);
    return buf;
}
