//~ ERROR: has no method
// calling a method that the trait does not declare is rejected
struct A { x: i32; }
trait T { func f(self: *Self) -> i32; }
impl T for A { func f(self: *A) -> i32 { return 1; } }
func main() -> i8 {
    let a: A = A { x: 1 };
    let d: dyn T = &a;
    d.missing();
    return 0;
}
