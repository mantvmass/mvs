/*
 * std/set.mvs - HashSet<T>: open-addressing hash set (linear probing)
 *
 * Usage:
 *     import { io } from "std";
 *     import { HashSet } from "std/set";
 *
 *     let s: HashSet<i64> = HashSet<i64>::new();
 *     s.insert(10);
 *     s.insert(20);
 *     s.insert(10);              // duplicate, no-op
 *     io.out("len = {}", s.len());   // 2
 *     io.out("has 10 = {}", s.contains(10));  // true
 *     s.remove(10);
 *     s.drop();
 *
 * Element types: i64 and str (each needs a set_hash/set_eq overload below;
 * add a pair to support another type). Grows by doubling at 70% load.
 * remove() uses tombstone deletion (same as HashMap).
 */

extern func realloc(p: *u8, n: usize) -> *u8;
extern func free(p: *u8) -> void;
extern func strcmp(a: str, b: str) -> i32;

// --- per-element-type hash + equality ---

func set_hash(k: i64) -> u64 {
    let x: u64 = k as u64;
    x = (x ^ (x >> 30)) * 0xBF58476D1CE4E5B9;
    x = (x ^ (x >> 27)) * 0x94D049BB133111EB;
    return x ^ (x >> 31);
}

func set_hash(k: str) -> u64 {
    let p: *u8 = k as *u8;
    let h: u64 = 0xCBF29CE484222325;
    let i: usize = 0;
    while (p[i] != 0) {
        h = (h ^ p[i]) * 0x100000001B3;
        i = i + 1;
    }
    return h;
}

func set_eq(a: i64, b: i64) -> bool { return a == b; }
func set_eq(a: str, b: str) -> bool { return strcmp(a, b) == 0; }

struct HashSet<T> {
    keys: *T;
    state: *u8;      // 0 = empty, 1 = occupied, 2 = tombstone
    cap: usize;
    len: usize;
}

impl HashSet<T> {
    func new() -> HashSet<T> {
        let s: HashSet<T> = HashSet<T> { keys: 0, state: 0, cap: 0, len: 0 };
        return s;
    }

    func len(self: *HashSet<T>) -> usize { return self.len; }
    func is_empty(self: *HashSet<T>) -> bool { return self.len == 0; }

    func ksize(self: *HashSet<T>) -> usize {
        return ((self.keys + 1) as usize) - (self.keys as usize);
    }

    func grow(self: *HashSet<T>) -> void {
        let ocap: usize = self.cap;
        let okeys: *T = self.keys;
        let ostate: *u8 = self.state;
        let ncap: usize = ocap * 2;
        if (ncap == 0) { ncap = 8; }
        self.keys = realloc(0, ncap * self.ksize()) as *T;
        self.state = realloc(0, ncap);
        let z: usize = 0;
        while (z < ncap) { self.state[z] = 0; z = z + 1; }
        self.cap = ncap;
        self.len = 0;
        let i: usize = 0;
        while (i < ocap) {
            if (ostate[i] == 1) { self.insert(okeys[i]); }
            i = i + 1;
        }
        if (ocap > 0) {
            free(okeys as *u8);
            free(ostate);
        }
    }

    // insert a value; returns true if it was new, false if already present
    func insert(self: *HashSet<T>, k: T) -> bool {
        if (self.len * 10 >= self.cap * 7) { self.grow(); }
        let i: usize = set_hash(k) % self.cap;
        let tomb: i64 = 0 - 1;
        while (self.state[i] != 0) {
            if (self.state[i] == 1 && set_eq(self.keys[i], k)) {
                return false;
            }
            if (self.state[i] == 2 && tomb < 0) { tomb = i as i64; }
            i = (i + 1) % self.cap;
        }
        if (tomb >= 0) { i = tomb as usize; }
        self.state[i] = 1;
        self.keys[i] = k;
        self.len = self.len + 1;
        return true;
    }

    func contains(self: *HashSet<T>, k: T) -> bool {
        if (self.cap == 0) { return false; }
        let i: usize = set_hash(k) % self.cap;
        while (self.state[i] != 0) {
            if (self.state[i] == 1 && set_eq(self.keys[i], k)) {
                return true;
            }
            i = (i + 1) % self.cap;
        }
        return false;
    }

    // remove a value; returns true if it was present
    func remove(self: *HashSet<T>, k: T) -> bool {
        if (self.cap == 0) { return false; }
        let i: usize = set_hash(k) % self.cap;
        while (self.state[i] != 0) {
            if (self.state[i] == 1 && set_eq(self.keys[i], k)) {
                self.state[i] = 2;
                self.len = self.len - 1;
                return true;
            }
            i = (i + 1) % self.cap;
        }
        return false;
    }

    func clear(self: *HashSet<T>) -> void {
        let i: usize = 0;
        while (i < self.cap) {
            self.state[i] = 0;
            i = i + 1;
        }
        self.len = 0;
    }

    func drop(self: *HashSet<T>) -> void {
        if (self.cap > 0) {
            free(self.keys as *u8);
            free(self.state);
        }
        self.keys = 0; self.state = 0;
        self.cap = 0; self.len = 0;
    }
}
