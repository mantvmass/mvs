import { io } from "std";
import { Vec } from "std/vec";
import { String } from "std/string";

struct Item { name: str; }
struct Builder { items: Vec<Item>; tag: i64; }

impl Builder {
    func new() -> Builder { return Builder { items: Vec<Item>::new(), tag: 0 }; }
    func add(self: *Builder, name: str) -> Builder {
        self.items.push(Item { name: name });
        return *self;
    }
    func tagged(self: *Builder, t: i64) -> Builder {
        self.tag = t;
        return *self;
    }
    func drop(self: *Builder) -> void { self.items.drop(); }
}

struct Res { code: i64; body: String; }
impl Res {
    func text(code: i64, body: str) -> Res {
        return Res { code: code, body: String::from(body) };
    }
    func header(self: *Res, h: str) -> Res {
        self.body.push_str(h);
        return *self;
    }
}

func main() -> i8 {
    let b: Builder = Builder::new().add("a").add("b").add("c").tagged(7);
    io.out("items={} tag={}", b.items.len(), b.tag);
    let i: usize = 0;
    while (i < b.items.len()) { io.out("  {}", b.items.get(i).name); i = i + 1; }
    b.drop();

    let r: Res = Res::text(200, "body").header("|H1").header("|H2");
    io.out("code={} body={}", r.code, r.body.as_str());
    r.body.drop();
    return 0;
}
