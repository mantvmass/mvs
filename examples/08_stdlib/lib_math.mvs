// std/math: libm wrappers plus integer helpers, overloaded across i64/f64
import { io, math } from "std";

func main() -> i8 {
    // libm wrappers
    io.out("sqrt(2) = {}", math.sqrt(2.0));
    io.out("pow(2,10) = {}", math.pow(2.0, 10.0));
    io.out("floor/ceil = {} {}", math.floor(2.7), math.ceil(2.1));
    io.out("fmod = {}", math.fmod(7.5, 2.0));
    io.out("pi = {}", math.pi());

    // overloaded integer/float helpers
    io.out("abs = {} {}", math.abs(0 - 42), math.abs(0.0 - 2.5));
    io.out("min/max = {} {}", math.min(3, 8), math.max(3, 8));
    io.out("fmin/fmax = {} {}", math.min(1.5, 2.5), math.max(1.5, 2.5));
    io.out("clamp = {} {} {}", math.clamp(12, 0, 10), math.clamp(0 - 3, 0, 10), math.clamp(5, 0, 10));

    // pure MVS integer math
    io.out("sign = {} {} {}", math.sign(0 - 9), math.sign(0), math.sign(7));
    io.out("gcd = {}", math.gcd(48, 18));
    io.out("lcm = {}", math.lcm(4, 6));
    io.out("ipow = {}", math.ipow(3, 7));
    return 0;
}
