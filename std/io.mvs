/*
 * std/io.mvs - the io module of the standard library (written in MVS itself)
 *
 * Usage:
 *     import { io } from "std";
 *     io.out("hello");                       // print a message (newline appended automatically)
 *     io.out("number = {}", 42);             // Rust-style interpolation with {}
 *     io.out("{} + {} = {}", a, b, a + b);   // multiple values
 *     io.out("hex = {:x}", 255);             // hexadecimal
 *     io.print("no newline");                // raw print, no newline
 *
 * Note: io.out is a compiler intrinsic (like Rust's println!, which is a macro),
 *       because it must parse {} and pick the print type at compile time.
 *       The other functions below are plain MVS calling printf via extern.
 */

// foreign functions from the C runtime
extern func printf(fmt: str) -> i32;
extern func scanf(fmt: str) -> i32;
extern func malloc(n: usize) -> *u8;

// print a string with no newline and no formatting
func print(s: str) -> void {
    printf("%s", s);
}

// show a prompt, then read one word from the user (no whitespace); returns it as a string
func in(prompt: str) -> str {
    printf("%s", prompt);
    let buf: *u8 = malloc(256);
    scanf("%255s", buf);
    return buf;
}
