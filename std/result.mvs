/*
 * std/result.mvs - Result<T, E>: success (T) or error (E), Rust style
 *
 * Usage:
 *     import { Result, Ok, Err } from "std/result";
 *
 *     func parse_positive(x: i64) -> Result<i64, str> {
 *         if (x < 0) { return Err<i64, str>("negative"); }
 *         return Ok<i64, str>(x);
 *     }
 *
 *     let r: Result<i64, str> = parse_positive(5);
 *     if (r.is_ok()) { io.out("value = {}", r.unwrap()); }
 *     else { io.out("error = {}", r.unwrap_err()); }
 *
 * Note: a Result carries TWO type parameters and only one side has a runtime
 * value, so Ok/Err take both types explicitly: Ok<i64, str>(v).
 */

extern func printf(fmt: str) -> i32;
extern func exit(code: i32) -> void;

struct Result<T, E> {
    okf: bool;
    val: T;
    err: E;
}

impl Result<T, E> {
    func is_ok(self: *Result<T, E>) -> bool { return self.okf; }
    func is_err(self: *Result<T, E>) -> bool { return !self.okf; }

    // the success value; aborts when this Result is an error
    func unwrap(self: *Result<T, E>) -> T {
        if (!self.okf) {
            printf("panic: called unwrap() on an Err value\n");
            exit(1);
        }
        return self.val;
    }

    // the error value; aborts when this Result is a success
    func unwrap_err(self: *Result<T, E>) -> E {
        if (self.okf) {
            printf("panic: called unwrap_err() on an Ok value\n");
            exit(1);
        }
        return self.err;
    }

    // the success value, or the fallback when this Result is an error
    func unwrap_or(self: *Result<T, E>, fallback: T) -> T {
        if (self.okf) { return self.val; }
        return fallback;
    }
}

// a success (both types explicit: Ok<i64, str>(v))
func Ok<T, E>(v: T) -> Result<T, E> {
    let r: Result<T, E> = Result<T, E> { okf: true, val: v };
    return r;
}

// an error (both types explicit: Err<i64, str>(e))
func Err<T, E>(e: E) -> Result<T, E> {
    let r: Result<T, E> = Result<T, E> { okf: false, err: e };
    return r;
}
