// ============================================================
//  export_lib: export MVS functions for C to call (no main)
//  build:  mvs.exe examples/07_c_interop/export_lib.mvs -c
//          clang caller.c export_lib.obj -o app.exe -llegacy_stdio_definitions
//  run:    app.exe
//
//  export -> uses the raw symbol name (mvs_square) so C can call it directly; the C side
//  declares a matching prototype (see caller.c)
// ============================================================

export func mvs_square(x: i32) -> i32 { return x * x; }

export func mvs_sum_to(n: i64) -> i64 {
    let total: i64 = 0;
    for (let i: i64 = 1; i <= n; i++) { total += i; }
    return total;
}

// f32 across the boundary: an export takes/returns C single precision
export func mvs_scale(x: f32, k: f32) -> f32 { return x * k; }

// f32 in stack positions 5-6 (e, f): the C caller writes single-precision slots
export func mvs_sumf(a: f32, b: f32, c: f32, d: f32, e: f32, f: f32) -> f32 {
    return a + b + c + d + e + f;
}

// MVS calling its own export: the call site must use the same C convention
// (narrow f32 arguments, widen the f32 return) as an external caller would
export func mvs_scale_twice(x: f32) -> f32 {
    return mvs_scale(mvs_scale(x, 2.0), 2.0);
}
