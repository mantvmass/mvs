/*
 * std/string.mvs - the String type owning heap memory (owned, growable)
 *
 * Usage:
 *     import { string } from "std";
 *     import { String } from "std/string";
 *     let s: String = String::from("hello");
 *     s.push_str(", world");
 *     io.out("{}", s.as_str());      // hello, world
 *     s.drop();                       // free the memory when done (manual management)
 *
 *     let n: String = String::from_int(42);  // "42"
 *
 * Note: String keeps a null-terminated buffer on the heap, so it converts to `str`
 *       (passable to io.out/printf) directly. It is a std module (depends on CRT
 *       malloc/free) and is not used in --nostd mode.
 */

import { Vec } from "std/vec";

// foreign functions from the C runtime
extern func malloc(n: usize) -> *u8;
extern func realloc(p: *u8, n: usize) -> *u8;
extern func free(p: *u8) -> void;
extern func memcpy(dst: *u8, src: *u8, n: usize) -> *u8;
extern func memmove(dst: *u8, src: *u8, n: usize) -> *u8;
extern func strlen(s: str) -> usize;
extern func strcmp(a: str, b: str) -> i32;
extern func sprintf(buf: *u8, fmt: str) -> i32;

// String: heap buffer (null-terminated) + length + capacity
struct String {
    data: *u8;
    len:  usize;
    cap:  usize;
}

impl String {
    func new() -> String {
        let buf: *u8 = malloc(1);
        *buf = 0;
        return String { data: buf, len: 0, cap: 1 };
    }

    // pre-allocate a buffer of at least n bytes (empty content)
    func with_capacity(n: usize) -> String {
        let c: usize = n + 1;
        let buf: *u8 = malloc(c);
        *buf = 0;
        return String { data: buf, len: 0, cap: c };
    }

    func from(s: str) -> String {
        let n: usize = strlen(s);
        let buf: *u8 = malloc(n + 1);
        memcpy(buf, s, n + 1);
        return String { data: buf, len: n, cap: n + 1 };
    }

    func from_int(v: i64) -> String {
        let buf: *u8 = malloc(32);
        sprintf(buf, "%lld", v);
        return String { data: buf, len: strlen(buf), cap: 32 };
    }

    func from_uint(v: u64) -> String {
        let buf: *u8 = malloc(32);
        sprintf(buf, "%llu", v);
        return String { data: buf, len: strlen(buf), cap: 32 };
    }

    func from_bytes(data: *u8, n: usize) -> String {
        let buf: *u8 = malloc(n + 1);
        memcpy(buf, data, n);
        buf[n] = 0;
        return String { data: buf, len: n, cap: n + 1 };
    }

    func from_float(v: f64) -> String {
        let buf: *u8 = malloc(48);
        sprintf(buf, "%f", v);
        return String { data: buf, len: strlen(buf), cap: 48 };
    }

    func from_char(c: char) -> String {
        let buf: *u8 = malloc(2);
        *buf = c as u8;
        *(buf + 1) = 0;
        return String { data: buf, len: 1, cap: 2 };
    }

    func len(self: *String) -> usize { return self.len; }
    func is_empty(self: *String) -> bool { return self.len == 0; }
    func as_str(self: *String) -> str { return self.data; }
    func as_ptr(self: *String) -> *u8 { return self.data; }

    // grow the internal buffer so it holds at least need_cap bytes (including NUL)
    func ensure(self: *String, need_cap: usize) -> void {
        if (need_cap <= self.cap) { return; }
        let nc: usize = self.cap * 2;
        if (nc < need_cap) { nc = need_cap; }
        self.data = realloc(self.data, nc);
        self.cap = nc;
    }

    // append a str; returns *self for chaining
    func push_str(self: *String, s: str) -> *String {
        let slen: usize = strlen(s);
        self.ensure(self.len + slen + 1);
        memcpy(self.data + self.len, s, slen + 1);
        self.len = self.len + slen;
        return self;
    }

    // append a single byte
    func push_char(self: *String, c: char) -> *String {
        self.ensure(self.len + 2);
        self.data[self.len] = c as u8;
        self.len = self.len + 1;
        self.data[self.len] = 0;
        return self;
    }

    // deep copy
    func clone(self: *String) -> String {
        let buf: *u8 = malloc(self.len + 1);
        memcpy(buf, self.data, self.len + 1);
        return String { data: buf, len: self.len, cap: self.len + 1 };
    }

    // content equality
    func eq(self: *String, other: str) -> bool {
        return strcmp(self.data, other) == 0;
    }

    // the byte at index i (0 when out of range)
    func char_at(self: *String, i: usize) -> char {
        if (i >= self.len) { return 0 as char; }
        return self.data[i] as char;
    }

    // byte at index i as u8
    func byte_at(self: *String, i: usize) -> u8 {
        if (i >= self.len) { return 0; }
        return self.data[i];
    }

    // does the string contain the given substring?
    func contains(self: *String, needle: str) -> bool {
        return self.index_of(needle) >= 0;
    }

    // index of the first occurrence of needle, or -1
    func index_of(self: *String, needle: str) -> i64 {
        let nlen: usize = strlen(needle);
        if (nlen == 0) { return 0; }
        if (nlen > self.len) { return 0 - 1; }
        let np: *u8 = needle;
        let i: usize = 0;
        while (i + nlen <= self.len) {
            let j: usize = 0;
            while (j < nlen && self.data[i + j] == np[j]) { j = j + 1; }
            if (j == nlen) { return i as i64; }
            i = i + 1;
        }
        return 0 - 1;
    }

    // index of the last occurrence of needle, or -1
    func last_index_of(self: *String, needle: str) -> i64 {
        let nlen: usize = strlen(needle);
        if (nlen == 0) { return self.len as i64; }
        if (nlen > self.len) { return 0 - 1; }
        let np: *u8 = needle;
        let i: i64 = (self.len - nlen) as i64;
        while (i >= 0) {
            let j: usize = 0;
            while (j < nlen && self.data[i as usize + j] == np[j]) { j = j + 1; }
            if (j == nlen) { return i; }
            i = i - 1;
        }
        return 0 - 1;
    }

    func starts_with(self: *String, prefix: str) -> bool {
        let plen: usize = strlen(prefix);
        if (plen > self.len) { return false; }
        let pp: *u8 = prefix;
        let i: usize = 0;
        while (i < plen) {
            if (self.data[i] != pp[i]) { return false; }
            i = i + 1;
        }
        return true;
    }

    func ends_with(self: *String, suffix: str) -> bool {
        let slen: usize = strlen(suffix);
        if (slen > self.len) { return false; }
        let sp: *u8 = suffix;
        let off: usize = self.len - slen;
        let i: usize = 0;
        while (i < slen) {
            if (self.data[off + i] != sp[i]) { return false; }
            i = i + 1;
        }
        return true;
    }

    // a new String containing bytes [start, start+count)
    func substring(self: *String, start: usize, count: usize) -> String {
        let s: usize = start;
        if (s > self.len) { s = self.len; }
        let c: usize = count;
        if (s + c > self.len) { c = self.len - s; }
        let buf: *u8 = malloc(c + 1);
        memcpy(buf, self.data + s, c);
        buf[c] = 0;
        return String { data: buf, len: c, cap: c + 1 };
    }

    // remove leading and trailing ASCII whitespace (space, tab, CR, LF)
    func trim(self: *String) -> String {
        let s: usize = 0;
        while (s < self.len && is_ws(self.data[s])) { s = s + 1; }
        let e: usize = self.len;
        while (e > s && is_ws(self.data[e - 1])) { e = e - 1; }
        return self.substring(s, e - s);
    }

    func trim_start(self: *String) -> String {
        let s: usize = 0;
        while (s < self.len && is_ws(self.data[s])) { s = s + 1; }
        return self.substring(s, self.len - s);
    }

    func trim_end(self: *String) -> String {
        let e: usize = self.len;
        while (e > 0 && is_ws(self.data[e - 1])) { e = e - 1; }
        return self.substring(0, e);
    }

    // convert ASCII letters to upper/lower case (returns a new String)
    func to_upper(self: *String) -> String {
        let buf: *u8 = malloc(self.len + 1);
        let i: usize = 0;
        while (i < self.len) {
            let b: u8 = self.data[i];
            if (b >= 97 && b <= 122) { b = b - 32; }
            buf[i] = b;
            i = i + 1;
        }
        buf[self.len] = 0;
        return String { data: buf, len: self.len, cap: self.len + 1 };
    }

    func to_lower(self: *String) -> String {
        let buf: *u8 = malloc(self.len + 1);
        let i: usize = 0;
        while (i < self.len) {
            let b: u8 = self.data[i];
            if (b >= 65 && b <= 90) { b = b + 32; }
            buf[i] = b;
            i = i + 1;
        }
        buf[self.len] = 0;
        return String { data: buf, len: self.len, cap: self.len + 1 };
    }

    // replace all occurrences of old with new (returns a new String)
    func replace(self: *String, old: str, new: str) -> String {
        let olen: usize = strlen(old);
        let nlen: usize = strlen(new);
        if (olen == 0) { return self.clone(); }
        let op: *u8 = old;
        let np: *u8 = new;
        let out: String = String::new();
        let i: usize = 0;
        while (i < self.len) {
            if (i + olen <= self.len) {
                let j: usize = 0;
                while (j < olen && self.data[i + j] == op[j]) { j = j + 1; }
                if (j == olen) {
                    let k: usize = 0;
                    while (k < nlen) {
                        out.push_char(np[k] as char);
                        k = k + 1;
                    }
                    i = i + olen;
                    continue;
                }
            }
            out.push_char(self.data[i] as char);
            i = i + 1;
        }
        return out;
    }

    // repeat the string n times
    func repeat(self: *String, n: usize) -> String {
        let out: String = String::with_capacity(self.len * n);
        let i: usize = 0;
        while (i < n) {
            out.push_str(self.data);
            i = i + 1;
        }
        return out;
    }

    // count non-overlapping occurrences of needle
    func count(self: *String, needle: str) -> usize {
        let nlen: usize = strlen(needle);
        if (nlen == 0) { return 0; }
        let np: *u8 = needle;
        let c: usize = 0;
        let i: usize = 0;
        while (i + nlen <= self.len) {
            let j: usize = 0;
            while (j < nlen && self.data[i + j] == np[j]) { j = j + 1; }
            if (j == nlen) { c = c + 1; i = i + nlen; }
            else { i = i + 1; }
        }
        return c;
    }

    // truncate to the first n bytes (no-op when already shorter)
    func truncate(self: *String, n: usize) -> void {
        if (n < self.len) {
            self.len = n;
            self.data[n] = 0;
        }
    }

    // remove all content but keep the buffer
    func clear(self: *String) -> void {
        self.len = 0;
        self.data[0] = 0;
    }

    func drop(self: *String) -> void { free(self.data); }
}

// split a String by delimiter into a Vec of Strings
func split(s: *String, delim: str) -> Vec<String> {
    let out: Vec<String> = Vec<String>::new();
    let dlen: usize = strlen(delim);
    if (dlen == 0) {
        out.push(s.clone());
        return out;
    }
    let dp: *u8 = delim;
    let start: usize = 0;
    let i: usize = 0;
    while (i + dlen <= s.len) {
        let j: usize = 0;
        while (j < dlen && s.data[i + j] == dp[j]) { j = j + 1; }
        if (j == dlen) {
            out.push(s.substring(start, i - start));
            i = i + dlen;
            start = i;
        } else {
            i = i + 1;
        }
    }
    out.push(s.substring(start, s.len - start));
    return out;
}

// join a Vec of Strings with a separator
func join(parts: *Vec<String>, sep: str) -> String {
    let out: String = String::new();
    let i: usize = 0;
    while (i < parts.len()) {
        if (i > 0) { out.push_str(sep); }
        let part: String = parts.get(i);
        out.push_str(part.as_str());
        i = i + 1;
    }
    return out;
}

// vec_eq overload for String (needed when Vec<String>.contains/index_of is instantiated)
func vec_eq(a: String, b: String) -> bool {
    return strcmp(a.as_str(), b.as_str()) == 0;
}

// helper: is the byte ASCII whitespace?
func is_ws(b: u8) -> bool {
    return b == 32 || b == 9 || b == 10 || b == 13;
}
