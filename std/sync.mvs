/*
 * std/sync.mvs - synchronization primitives (Mutex, RwLock, CondVar)
 *
 *     import { io, thread, sync } from "std";
 *
 *     let m: Mutex;                 // a zeroed Mutex IS a valid unlocked Mutex
 *     let counter: i64 = 0;
 *
 *     func worker(arg: *u8) -> *u8 {
 *         m.lock();
 *         counter = counter + 1;    // protected region
 *         m.unlock();
 *         return 0;
 *     }
 *
 * The 64-byte buffer covers both implementations: Windows SRWLOCK (8 bytes,
 * zero-initialized by definition) and glibc pthread_mutex_t (40-48 bytes,
 * PTHREAD_MUTEX_INITIALIZER is all-zero). Do not copy a Mutex by value.
 */

@compile(target_os = "windows")
extern func AcquireSRWLockExclusive(p: *u64) -> void;
@compile(target_os = "windows")
extern func ReleaseSRWLockExclusive(p: *u64) -> void;

@compile(target_os = "linux")
extern func pthread_mutex_lock(p: *u64) -> i32;
@compile(target_os = "linux")
extern func pthread_mutex_unlock(p: *u64) -> i32;

// 64 zero bytes; field a is the OS lock word(s), the rest is reserved space
struct Mutex {
    a: u64; b: u64; c: u64; d: u64;
    e: u64; f: u64; g: u64; h: u64;
}

// a fresh unlocked Mutex (a zeroed one; handy for locals)
impl Mutex {
    func new() -> Mutex {
        let m: Mutex = Mutex { a: 0, b: 0, c: 0, d: 0, e: 0, f: 0, g: 0, h: 0 };
        return m;
    }
}

@compile(target_os = "windows")
impl Mutex {
    func lock(self: *Mutex) -> void { AcquireSRWLockExclusive(&self.a); }
    func unlock(self: *Mutex) -> void { ReleaseSRWLockExclusive(&self.a); }
}

@compile(target_os = "linux")
impl Mutex {
    func lock(self: *Mutex) -> void { pthread_mutex_lock(&self.a); }
    func unlock(self: *Mutex) -> void { pthread_mutex_unlock(&self.a); }
}

/*
 * RwLock: a readers-writer lock (multiple readers XOR one writer).
 *
 * Windows: SRWLock supports both shared (read) and exclusive (write) modes,
 * same 8-byte zero-initialized structure as used for Mutex.
 * Linux: pthread_rwlock_t (56 bytes on glibc, fits in 64 bytes).
 *
 *     let rw: RwLock = RwLock::new();
 *     rw.read_lock();    // shared
 *     rw.read_unlock();
 *     rw.write_lock();   // exclusive
 *     rw.write_unlock();
 */

@compile(target_os = "windows")
extern func AcquireSRWLockShared(p: *u64) -> void;
@compile(target_os = "windows")
extern func ReleaseSRWLockShared(p: *u64) -> void;

@compile(target_os = "linux")
extern func pthread_rwlock_init(p: *u64, attr: *u8) -> i32;
@compile(target_os = "linux")
extern func pthread_rwlock_rdlock(p: *u64) -> i32;
@compile(target_os = "linux")
extern func pthread_rwlock_wrlock(p: *u64) -> i32;
@compile(target_os = "linux")
extern func pthread_rwlock_unlock(p: *u64) -> i32;

struct RwLock {
    a: u64; b: u64; c: u64; d: u64;
    e: u64; f: u64; g: u64; h: u64;
}

impl RwLock {
    func new() -> RwLock {
        let rw: RwLock = RwLock { a: 0, b: 0, c: 0, d: 0, e: 0, f: 0, g: 0, h: 0 };
        return rw;
    }
}

@compile(target_os = "windows")
impl RwLock {
    func read_lock(self: *RwLock) -> void { AcquireSRWLockShared(&self.a); }
    func read_unlock(self: *RwLock) -> void { ReleaseSRWLockShared(&self.a); }
    func write_lock(self: *RwLock) -> void { AcquireSRWLockExclusive(&self.a); }
    func write_unlock(self: *RwLock) -> void { ReleaseSRWLockExclusive(&self.a); }
}

@compile(target_os = "linux")
impl RwLock {
    func read_lock(self: *RwLock) -> void { pthread_rwlock_rdlock(&self.a); }
    func read_unlock(self: *RwLock) -> void { pthread_rwlock_unlock(&self.a); }
    func write_lock(self: *RwLock) -> void { pthread_rwlock_wrlock(&self.a); }
    func write_unlock(self: *RwLock) -> void { pthread_rwlock_unlock(&self.a); }
}

/*
 * CondVar: a condition variable for thread signaling.
 *
 * Windows: CONDITION_VARIABLE (8 bytes, zero-initialized).
 * Linux: pthread_cond_t (48 bytes on glibc, fits in 64 bytes with
 * PTHREAD_COND_INITIALIZER being all-zero).
 *
 *     let cv: CondVar = CondVar::new();
 *     let m: Mutex = Mutex::new();
 *     // producer: m.lock(); ... cv.signal(); m.unlock();
 *     // consumer: m.lock(); cv.wait(&m); m.unlock();
 *
 * wait() atomically releases the mutex and sleeps. When it returns the
 * mutex is re-acquired. Always recheck the predicate in a loop: spurious
 * wakeups are allowed by both platforms.
 */

@compile(target_os = "windows")
extern func SleepConditionVariableSRW(cv: *u64, srw: *u64, ms: u32, flags: u32) -> i32;
@compile(target_os = "windows")
extern func WakeConditionVariable(cv: *u64) -> void;
@compile(target_os = "windows")
extern func WakeAllConditionVariable(cv: *u64) -> void;

@compile(target_os = "linux")
extern func pthread_cond_wait(cv: *u64, mtx: *u64) -> i32;
@compile(target_os = "linux")
extern func pthread_cond_signal(cv: *u64) -> i32;
@compile(target_os = "linux")
extern func pthread_cond_broadcast(cv: *u64) -> i32;

struct CondVar {
    a: u64; b: u64; c: u64; d: u64;
    e: u64; f: u64; g: u64; h: u64;
}

impl CondVar {
    func new() -> CondVar {
        let cv: CondVar = CondVar { a: 0, b: 0, c: 0, d: 0, e: 0, f: 0, g: 0, h: 0 };
        return cv;
    }
}

@compile(target_os = "windows")
impl CondVar {
    func wait(self: *CondVar, m: *Mutex) -> void {
        SleepConditionVariableSRW(&self.a, &m.a, 4294967295, 0);
    }
    func signal(self: *CondVar) -> void { WakeConditionVariable(&self.a); }
    func broadcast(self: *CondVar) -> void { WakeAllConditionVariable(&self.a); }
}

@compile(target_os = "linux")
impl CondVar {
    func wait(self: *CondVar, m: *Mutex) -> void { pthread_cond_wait(&self.a, &m.a); }
    func signal(self: *CondVar) -> void { pthread_cond_signal(&self.a); }
    func broadcast(self: *CondVar) -> void { pthread_cond_broadcast(&self.a); }
}
