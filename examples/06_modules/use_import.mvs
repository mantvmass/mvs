// ============================================================
//  use_import — นำเข้าข้ามไฟล์
//  build:  mvs.exe examples/06_modules/use_import.mvs
//  run:    examples\06_modules\use_import.exe
//
//  รูปแบบ import (path เป็นตัวกำหนด):
//   A) import { io } from "std"               submodule ของ package -> namespace (io.out)
//   B) import { square } from "./mathlib.mvs" ดึงสัญลักษณ์ตรง ๆ
//   C) import m from "./mathlib.mvs"          ทั้งโมดูลเป็น namespace (m.square) — ดูหมายเหตุ
//  หมายเหตุ: หนึ่งโมดูลผูกได้หนึ่ง namespace ต่อการ build — เลือกรูปแบบ B หรือ C ต่อไฟล์ (อย่าผสมไฟล์เดียวกัน)
// ============================================================
import { io } from "std";                          // A
import { square, factorial } from "./mathlib.mvs"; // B

func main() -> i8 {
    io.out("square(9) = {}", square(9));            // 81
    io.out("factorial(6) = {}", factorial(6));      // 720
    return 0;
}
