// HashMap<K, V>: open addressing with linear probing, built on generic structs.
// get() returns Option<V>, so a missing key is a value you match on rather
// than a sentinel you remember to check.
import { io } from "std";
import { HashMap } from "std/map";
import { Option, Some, None } from "std/option";

func main() -> i8 {
    // i64 keys: 100 inserts force several growth + rehash rounds
    let squares: HashMap<i64, i64> = HashMap<i64, i64>::new();
    let i: i64 = 0;
    while (i < 100) {
        squares.insert(i, i * i);
        i = i + 1;
    }
    io.out("len = {}", squares.len());
    match (squares.get(12)) {
        Some(v) => { io.out("12^2 = {}", v); }
        None => { io.out("missing"); }
    }
    io.out("has 99 = {} has 100 = {}", squares.contains(99), squares.contains(100));
    squares.insert(12, 0);                      // overwrite, not a second entry
    io.out("after overwrite = {} len = {}", squares.get(12).unwrap(), squares.len());
    squares.drop();

    // str keys and str values (FNV-1a hashing + strcmp equality)
    let caps: HashMap<str, str> = HashMap<str, str>::new();
    caps.insert("th", "Bangkok");
    caps.insert("jp", "Tokyo");
    caps.insert("fr", "Paris");
    match (caps.get("jp")) {
        Some(c) => { io.out("jp -> {}", c); }
        None => { io.out("unknown"); }
    }
    let missing: str = match (caps.get("de")) {
        Some(c) => c,
        None => "(none)",
    };
    io.out("de -> {}", missing);
    io.out("len = {} empty = {}", caps.len(), caps.is_empty());
    caps.drop();
    return 0;
}
