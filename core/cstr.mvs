/*
 * core/cstr.mvs - NUL-terminated string operations in pure MVS (--nostd safe)
 *
 * ("cstr" because `str` is a type keyword; these are classic C strings.)
 *
 *     import { cstr } from "core";
 *     if (cstr.eq(name, "root")) { ... }
 */

// length in bytes (not counting the terminator)
func len(s: str) -> usize {
    let p: *u8 = s as *u8;
    let n: usize = 0;
    while (p[n] != 0) { n = n + 1; }
    return n;
}

// content equality
func eq(a: str, b: str) -> bool {
    let x: *u8 = a as *u8;
    let y: *u8 = b as *u8;
    let i: usize = 0;
    while (x[i] != 0 && y[i] != 0) {
        if (x[i] != y[i]) { return false; }
        i = i + 1;
    }
    return x[i] == y[i];
}

// lexicographic ordering: -1, 0, or 1
func cmp(a: str, b: str) -> i64 {
    let x: *u8 = a as *u8;
    let y: *u8 = b as *u8;
    let i: usize = 0;
    while (x[i] != 0 && x[i] == y[i]) { i = i + 1; }
    if (x[i] < y[i]) { return 0 - 1; }
    if (x[i] > y[i]) { return 1; }
    return 0;
}

// index of the first occurrence of byte c, or -1
func find(s: str, c: char) -> i64 {
    let p: *u8 = s as *u8;
    let i: i64 = 0;
    while (p[i] != 0) {
        if (p[i] == c as u8) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// does s start with the given prefix?
func starts_with(s: str, prefix: str) -> bool {
    let x: *u8 = s as *u8;
    let y: *u8 = prefix as *u8;
    let i: usize = 0;
    while (y[i] != 0) {
        if (x[i] != y[i]) { return false; }
        i = i + 1;
    }
    return true;
}

// bounded copy into dst (cap bytes total); always NUL-terminates when cap > 0.
// Returns the number of content bytes copied.
func copy(dst: *u8, src: str, cap: usize) -> usize {
    if (cap == 0) { return 0; }
    let s: *u8 = src as *u8;
    let i: usize = 0;
    while (i + 1 < cap && s[i] != 0) {
        dst[i] = s[i];
        i = i + 1;
    }
    dst[i] = 0;
    return i;
}
