// std/test: exercise the assertion helpers (ne, lt, gt, le, ge)
use std::{io, test};

func main() -> void {
    test.ne(1, 2);
    test.ne("a", "b");
    test.lt(3, 5);
    test.gt(5, 3);
    test.le(3, 3);
    test.le(2, 3);
    test.ge(3, 3);
    test.ge(4, 3);
    io.out("all assertions passed");
}
