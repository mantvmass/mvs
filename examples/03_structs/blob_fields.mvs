// 16-byte and float fields initialized from plain literals in a struct literal:
// the i128 high half must be widened (zero/sign extended), ints must convert to
// floats, and a method accumulating into an i128 field must stay exact.
import { io } from "std";

struct Acc {
    total: i128;
    ratio: f64;
    scale: f32;
    count: i64;
}

impl Acc {
    func add(self: *Acc, v: i128) -> void {
        self.total = self.total + v;
        self.count = self.count + 1;
    }
}

func dirty_stack() -> i64 {
    // leave nonzero bytes on the stack so an uninitialized high half would show
    let a: i64 = 0x1234567812345678;
    return a + a;
}

func main() -> i8 {
    dirty_stack();
    let a: Acc = Acc { total: 42, ratio: 2, scale: 3, count: 0 };
    io.out("total = {}", a.total);           // 42, not 42 + garbage * 2^64
    io.out("ratio = {}", a.ratio);           // 2.000000
    io.out("scale = {}", a.scale);           // 3.000000

    let n: Acc = Acc { total: 0 - 5, ratio: 0.5, scale: 1.5, count: 0 };
    io.out("neg = {}", n.total);             // -5 (sign-extended into 128 bits)

    let b: Acc = Acc { total: 0, ratio: 0.0, scale: 0.0, count: 0 };
    b.add(123456789012345678 as i128);
    b.add(1 as i128);
    b.add((1 as i128) << 100);
    io.out("sum = {}", b.total);             // 1267650600228352858285715551055
    io.out("count = {}", b.count);           // 3
    return 0;
}
