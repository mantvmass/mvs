// ============================================================
//  casts — แปลงชนิดด้วย `as` + การตรวจชนิดเวลาคอมไพล์
//  build:  mvs.exe examples/01_language/casts.mvs
//  run:    examples\01_language\casts.exe
//
//  ภาษานี้ "ไม่ยอมให้ชนิดมั่ว": 50 + "50" เป็น error ตอนคอมไพล์
//  ต้องการแปลงชนิดจริง ๆ ใช้ `as` (ผูกแน่นกว่าตัวดำเนินการคณิต)
// ============================================================
import { io } from "std";

func main() -> i8 {
    let a: i32 = 7;
    io.out("7 as f64 / 2.0 = {}", a as f64 / 2.0);   // 3.5  (ไม่ cast: 7/2 = 3)
    io.out("3.9 as i32 = {}", 3.9 as i32);           // 3    (ตัดเศษทิ้ง)
    io.out("300 as u8 = {}", 300 as u8);             // 44   (300 mod 256)
    io.out("255 (u8) as i8 = {}", 255 as u8 as i8);  // -1   (ตีความบิตใหม่)
    io.out("65 as char = {}", 65 as char);           // A
    io.out("a as i32 * 2 = {}", a as i32 * 2);       // 14   (= (a as i32) * 2)

    // implicit: int -> float ที่ขอบ (กำหนดค่า) ทำให้อัตโนมัติ
    let f: f64 = 5;                                   // 5.0
    io.out("let f64 = 5 -> {}", f);
    return 0;
}
