// ============================================================
//  io_demo: output with io.out (Rust-style {} formatting)
//  build:  mvs.exe examples/08_stdlib/io_demo.mvs
//  run:    examples\08_stdlib\io_demo.exe
// ============================================================
use std::io;
use std::string::String;

struct Point { x: i32; y: i32; }

impl Display for Point {
    func fmt(self: *Point) -> String {
        let s: String = String::from("Point { x: ");
        let xs: String = String::from_int(self.x as i64);
        s.push_str(xs.as_str()); xs.drop();
        s.push_str(", y: ");
        let ys: String = String::from_int(self.y as i64);
        s.push_str(ys.as_str()); ys.drop();
        s.push_str(" }");
        return s;
    }
}

func main() -> i8 {
    io.out("plain text");                                  // plain text (+ trailing newline)
    io.out("int={} float={} str={} char={} bool={}", 7, 2.5, "hi", 'A', true);
    io.out("hex: {:x}", 255);                              // ff
    io.out("literal braces: {{}}");                        // {}
    io.out("many args: {} {} {} {} {} {}", 1, 2, 3, 4, 5, 6);
    let pt: Point = Point { x: 3, y: 4 };
    io.out("struct: {}", pt);                              // Point { x: 3, y: 4 }

    io.print("no newline");                                // io.print: no trailing newline
    io.print(" ... continued\n");
    return 0;
}
