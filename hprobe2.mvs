import { io } from "std";
import { Server, Request, Response, send_request, read_response, response_status, response_body } from "std/http";
import { TcpServer, TcpSocket } from "std/net";
import { String } from "std/string";
import { mem } from "std";

func hello(_req: *Request, res: *Response) -> void { res.text(200, "hello world"); }

func main() -> i8 {
    let app: Server = Server::new();
    app.get("/", hello);
    let srv: TcpServer = app.bind_at("127.0.0.1", 47811);
    let sock: TcpSocket = send_request("127.0.0.1", 47811, "GET", "/", "");
    app.serve_once(&srv);
    let resp: String = read_response(&sock);
    io.out("status={}", response_status(resp.as_str()));
    let body: str = response_body(resp.as_str());
    io.out("body={}", body);
    mem.dealloc(body as *u8);
    resp.drop();
    sock.close();
    srv.close();
    app.drop();
    return 0;
}
