// ============================================================
//  http.mvs — ชั้น HTTP ของ vmass (เทียบ zephyr-http + zephyr-router)
//  Request (จับคู่เส้นทาง + query) · Response (builder) · parse_request
//  ใช้ String (std) + ยูทิลิตีจาก core.mvs — ไม่ extern C เพิ่มเอง
// ============================================================
import { String } from "std/string";
import { str_len, str_eq, substr, dealloc } from "./core.mvs";

// ───────────────────────── Request ─────────────────────────
// คำขอ HTTP ที่แยกแล้ว: method + path (ไม่รวม query) + query (ส่วนหลัง '?')
struct Request { method: str; path: str; query: str; }

impl Request {
    func matches(self: *Request, m: str, p: str) -> bool {
        return str_eq(self.method, m) && str_eq(self.path, p);
    }
    func is_get(self: *Request, p: str)    -> bool { return self.matches("GET", p); }
    func is_post(self: *Request, p: str)   -> bool { return self.matches("POST", p); }
    func is_put(self: *Request, p: str)    -> bool { return self.matches("PUT", p); }
    func is_delete(self: *Request, p: str) -> bool { return self.matches("DELETE", p); }
}

// ───────────────────────── Response (builder) ─────────────────────────
// status + content-type + body + location (สำหรับ redirect) + extra header เสริมหนึ่งบรรทัด
struct Response { status: i32; ctype: str; body: str; location: str; extra: str; }

impl Response {
    // constructors (คืน Response ตามค่า แล้ว chain ต่อด้วย method ที่คืน *self)
    func new() -> Response { return Response { status: 200, ctype: "text/html; charset=utf-8", body: "", location: "", extra: "" }; }
    func ok() -> Response  { return Response::new(); }
    func created() -> Response     { let r: Response = Response::new(); r.status = 201; return r; }
    func bad_request() -> Response { let r: Response = Response::new(); r.status = 400; r.body = "<h1>400 Bad Request</h1>"; return r; }
    func not_found() -> Response   { let r: Response = Response::new(); r.status = 404; r.body = "<h1>404 Not Found</h1>"; return r; }
    func server_error() -> Response{ let r: Response = Response::new(); r.status = 500; r.body = "<h1>500 Internal Server Error</h1>"; return r; }

    // builder methods (คืน *self เพื่อต่อ chain)
    func status(self: *Response, code: i32) -> *Response { self.status = code; return self; }
    func ctype(self: *Response, ct: str)    -> *Response { self.ctype = ct; return self; }
    func body(self: *Response, b: str)      -> *Response { self.body = b; return self; }
    func html(self: *Response, b: str)      -> *Response { self.ctype = "text/html; charset=utf-8"; self.body = b; return self; }
    func json(self: *Response, b: str)      -> *Response { self.ctype = "application/json"; self.body = b; return self; }
    func text(self: *Response, b: str)      -> *Response { self.ctype = "text/plain; charset=utf-8"; self.body = b; return self; }
    func header(self: *Response, line: str) -> *Response { self.extra = line; return self; }   // เช่น "Cache-Control: no-cache"
    func redirect(self: *Response, url: str) -> *Response { self.status = 302; self.location = url; self.body = ""; return self; }

    // terminal step: สร้าง HTTP response เต็มรูปเป็น String (status line + headers + body)
    func render(self: *Response) -> String {
        let r: String = String::from("HTTP/1.0 ");
        let code: String = String::from_int(self.status as i64);
        r.push_str(code.as_str()).push_str(" ").push_str(status_text(self.status));
        code.drop();
        r.push_str("\r\nContent-Type: ").push_str(self.ctype);
        if (str_len(self.location) > 0) { r.push_str("\r\nLocation: ").push_str(self.location); }
        if (str_len(self.extra) > 0)    { r.push_str("\r\n").push_str(self.extra); }
        r.push_str("\r\nContent-Length: ");
        let cl: String = String::from_int(str_len(self.body) as i64);
        r.push_str(cl.as_str());
        cl.drop();
        r.push_str("\r\nConnection: close\r\n\r\n").push_str(self.body);
        return r;
    }
}

// ───────────────────────── parsing / status ─────────────────────────

// ข้อความสถานะ HTTP สำหรับโค้ดที่พบบ่อย
func status_text(code: i32) -> str {
    if (code == 200) { return "OK"; }
    if (code == 201) { return "Created"; }
    if (code == 204) { return "No Content"; }
    if (code == 302) { return "Found"; }
    if (code == 400) { return "Bad Request"; }
    if (code == 401) { return "Unauthorized"; }
    if (code == 403) { return "Forbidden"; }
    if (code == 404) { return "Not Found"; }
    if (code == 418) { return "I'm a teapot"; }
    if (code == 500) { return "Internal Server Error"; }
    return "OK";
}

// แยก method + path + query จากบรรทัดแรก เช่น "GET /hello?x=1 HTTP/1.1"
//  -> method="GET", path="/hello", query="x=1"  (สตริงใหม่ที่ผู้เรียกต้องคืนภายหลัง)
func parse_request(raw: str) -> Request {
    let n: usize = str_len(raw);
    let i: usize = 0;
    while (i < n && *((raw as *u8) + i) != 32) { i = i + 1; }   // 32 = ' '
    let method: str = substr(raw, 0, i);
    // ช่วงของ target (path[?query]) อยู่ระหว่างช่องว่างแรกกับช่องว่างถัดไป
    let ps: usize = i + 1;
    let j: usize = ps;
    while (j < n && *((raw as *u8) + j) != 32) { j = j + 1; }
    // หา '?' ภายในช่วง target เพื่อแยก path กับ query (63 = '?')
    let q: usize = ps;
    while (q < j && *((raw as *u8) + q) != 63) { q = q + 1; }
    let path: str = substr(raw, ps, q - ps);
    // query เป็นสตริงบนฮีปเสมอ (แม้ว่าง) เพื่อให้ free_request คืนได้สม่ำเสมอ ไม่ต้องเดา
    let query: str;
    if (q < j) { query = substr(raw, q + 1, j - q - 1); }
    else       { query = substr(raw, j, 0); }
    return Request { method: method, path: path, query: query };
}

// คืนหน่วยความจำของสตริงทั้งสามที่ parse_request จองไว้ (เรียกหลังจัดการคำขอเสร็จ)
func free_request(req: *Request) -> void {
    dealloc(req.method as *u8);
    dealloc(req.path as *u8);
    dealloc(req.query as *u8);
}
