// ============================================================
//  shadow: scope shadowing, block scopes, and same-name different-type variables
//  build:  mvs.exe examples/01_language/shadow.mvs
//  run:    examples\01_language\shadow.exe
// ============================================================
import { io } from "std";

func main() -> i8 {
    let x: i32 = 1;
    io.out("outer x = {}", x);          // 1
    {
        let x: i32 = 2;                 // shadows the outer x inside this block
        io.out("inner x = {}", x);      // 2
        {
            let x: str = "three";       // shadowing can even change the type
            io.out("inner inner x = {}", x);   // three
        }
        io.out("back to inner x = {}", x);      // 2
    }
    io.out("back to outer x = {}", x);  // 1

    for (let x: i32 = 10; x < 12; x++) {         // loop variables shadow too
        io.out("loop x = {}", x);       // 10, 11
    }
    io.out("after loop x = {}", x);     // 1
    return 0;
}
