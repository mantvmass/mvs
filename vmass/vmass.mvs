// ============================================================
//  vmass.mvs — entry library ของเฟรมเวิร์ก (เทียบ zephyr-server + umbrella)
//
//  import แค่ไฟล์นี้ไฟล์เดียวก็ได้ทั้งเฟรมเวิร์ก:
//      import { App } from "./vmass.mvs";
//  (มันโหลด http.mvs/core.mvs ให้เอง → Request/Response พร้อมใช้)
//
//  routing แบบ builder + function pointer:
//      App::new()
//          .get("/", home)
//          .post("/save", save)
//          .fallback(my_404)        // (ไม่บังคับ) handler สำหรับ 404 เอง
//          .run();
//  handler เป็น  func(*Request) -> String  (คืนค่าจาก Response builder ด้วย .render())
// ============================================================
import { io, net } from "std";
import { String } from "std/string";
import { Request, parse_request, free_request } from "./http.mvs";  // โหลดชั้น http
import { alloc, dealloc } from "./core.mvs";

// เส้นทางหนึ่งรายการในตาราง: method + path + ฟังก์ชันจัดการ (function pointer)
struct Route { method: str; path: str; handler: func(*Request) -> String; }
// ขนาด Route = 3 ฟิลด์ × 8 ไบต์ = 24 (str + str + function pointer) ใช้ตอนจองตาราง
// (MVS ยังไม่มี sizeof/array type — จองฮีปเองแล้วทำดัชนีด้วย pointer arithmetic ที่ scale ตาม sizeof(Route))

// ───────────────────────── App (builder + runner) ─────────────────────────
struct App {
    host: str; port: u16; name: str;
    routes: *Route; count: i32; cap: i32;
    nf: func(*Request) -> String;   // handler 404 (เริ่มต้น = default_not_found, เปลี่ยนได้ด้วย .fallback())
}

impl App {
    func new() -> App {
        let cap: i32 = 64;
        return App {
            host: "0.0.0.0", port: 8080, name: "vmass",
            routes: alloc((cap as usize) * 24) as *Route, count: 0, cap: cap,
            nf: default_not_found
        };
    }

    // builder methods ตั้งค่า (คืน *self เพื่อต่อ chain)
    func host(self: *App, h: str)  -> *App { self.host = h; return self; }
    func port(self: *App, p: u16)  -> *App { self.port = p; return self; }
    func name(self: *App, n: str)  -> *App { self.name = n; return self; }

    // ลงทะเบียนเส้นทาง (คืน *self) — handler เป็น function pointer
    func route(self: *App, method: str, path: str, handler: func(*Request) -> String) -> *App {
        if (self.count < self.cap) {
            *(self.routes + self.count) = Route { method: method, path: path, handler: handler };
            self.count = self.count + 1;
        }
        return self;
    }
    func get(self: *App, path: str, handler: func(*Request) -> String)    -> *App { return self.route("GET", path, handler); }
    func post(self: *App, path: str, handler: func(*Request) -> String)   -> *App { return self.route("POST", path, handler); }
    func put(self: *App, path: str, handler: func(*Request) -> String)    -> *App { return self.route("PUT", path, handler); }
    func delete(self: *App, path: str, handler: func(*Request) -> String) -> *App { return self.route("DELETE", path, handler); }

    // ตั้ง handler สำหรับเมื่อไม่ตรงเส้นทางใด (404 แบบกำหนดเอง)
    func fallback(self: *App, handler: func(*Request) -> String) -> *App {
        self.nf = handler; return self;
    }

    // จับคู่คำขอกับตารางเส้นทาง แล้วเรียก handler (indirect call ผ่าน function pointer)
    func dispatch(self: *App, req: *Request) -> String {
        let i: i32 = 0;
        while (i < self.count) {
            let r: *Route = self.routes + i;
            if (req.matches(r.method, r.path)) { return r.handler(req); }
            i = i + 1;
        }
        return self.nf(req);   // handler 404 (เริ่มต้น default_not_found เสมอ จึงไม่ NULL)
    }

    // เริ่มรับคำขอ — วนรับทีละ connection แล้ว dispatch ตามตาราง
    func run(self: *App) -> void {
        let server: TcpServer = net.TcpServer(self.host, self.port);
        io.out("[{}] listening on http://{}:{}  ({} routes)", self.name, self.host, self.port, self.count);
        while (true) {
            let conn: TcpSocket = server.accept();
            let raw: str = conn.recv();
            let req: Request = parse_request(raw);
            io.out("  {} {}", req.method, req.path);

            let resp: String = self.dispatch(&req);
            conn.send(resp.as_str());
            conn.close();

            // คืนหน่วยความจำของคำขอนี้ทั้งหมด (กัน leak ต่อ connection)
            resp.drop();
            free_request(&req);
            dealloc(raw as *u8);   // บัฟเฟอร์จาก socket.recv()
        }
    }
}

// 404 เริ่มต้นเมื่อไม่ตรงเส้นทางใดและผู้ใช้ไม่ได้ตั้ง .fallback()
func default_not_found(req: *Request) -> String {
    return Response::not_found().render();
}
