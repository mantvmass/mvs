/*
 * std/string.mvs - the String type owning heap memory (owned, growable)
 *
 * Usage:
 *     import { string } from "std";
 *     let s: string.String = string.String::from("hello");
 *     s.push_str(", world");
 *     io.out("{}", s.as_str());      // hello, world
 *     s.drop();                       // free the memory when done (manual management)
 *
 *     let n: string.String = string.String::from_int(42);  // "42"
 *
 * Note: String keeps a null-terminated buffer on the heap, so it converts to `str`
 *       (passable to io.out/printf) directly. It is a std module (depends on CRT
 *       malloc/free) and is not used in --nostd mode.
 */

// foreign functions from the C runtime
extern func malloc(n: usize) -> *u8;
extern func free(p: *u8) -> void;
extern func memcpy(dst: *u8, src: *u8, n: usize) -> *u8;
extern func strlen(s: str) -> usize;
extern func sprintf(buf: *u8, fmt: str, v: i64) -> i32;

// String: heap buffer (null-terminated) + length + capacity
struct String {
    data: *u8;    // pointer to the heap buffer (ends with '\0')
    len:  usize;  // length of the text (excluding '\0')
    cap:  usize;  // reserved capacity (including '\0')
}

impl String {
    // associated function: create a String by copying the text from a str onto the heap
    func from(s: str) -> String {
        let n: usize = strlen(s);
        let buf: *u8 = malloc(n + 1);
        memcpy(buf, s, n + 1);                 // copy including the null terminator
        return String { data: buf, len: n, cap: n + 1 };
    }

    // associated function: create a String from an integer (e.g. 42 -> "42")
    func from_int(v: i64) -> String {
        let buf: *u8 = malloc(32);
        sprintf(buf, "%lld", v);               // convert the number to decimal text
        return String { data: buf, len: strlen(buf), cap: 32 };
    }

    func len(self: *String) -> usize { return self.len; }

    // return the buffer as a str (same pointer, null-terminated); usable with io.out directly
    func as_str(self: *String) -> str { return self.data; }

    // append text to the String (reallocate then copy); returns *self for chaining
    func push_str(self: *String, s: str) -> *String {
        let slen: usize = strlen(s);
        let newlen: usize = self.len + slen;
        let nbuf: *u8 = malloc(newlen + 1);
        memcpy(nbuf, self.data, self.len);          // existing part
        memcpy(nbuf + self.len, s, slen + 1);       // appended part (including '\0')
        free(self.data);                            // free the old buffer
        self.data = nbuf;
        self.len = newlen;
        self.cap = newlen + 1;
        return self;
    }

    // free the String's memory (call when done; this language manages memory manually)
    func drop(self: *String) -> void { free(self.data); }
}
