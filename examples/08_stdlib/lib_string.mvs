// std/string: String type methods
import { io } from "std";
import { String } from "std/string";

func main() -> void {
    let s: String = String::with_capacity(64);
    s.push_str("hello");
    s.push_char(44 as char);
    s.push_str(" world");
    io.out("{}", s.as_str());
    io.out("len = {}", s.len());
    io.out("as_ptr = {}", s.as_ptr() != 0 as *u8);
    io.out("char_at(0) = {}", s.char_at(0) as u8);
    io.out("byte_at(0) = {}", s.byte_at(0));

    let c: String = s.clone();
    io.out("clone = {}", c.as_str());
    c.drop();

    io.out("contains(\",\") = {}", s.contains(","));
    io.out("index_of(\"world\") = {}", s.index_of("world"));
    io.out("last_index_of(\"l\") = {}", s.last_index_of("l"));
    io.out("starts_with(\"hello\") = {}", s.starts_with("hello"));
    io.out("ends_with(\"world\") = {}", s.ends_with("world"));

    let sub: String = s.substring(0, 5);
    io.out("substring(0,5) = {}", sub.as_str());
    sub.drop();

    let ws: String = String::from("  hi  ");
    let t: String = ws.trim();
    io.out("trim = {}", t.as_str());
    let ts: String = ws.trim_start();
    io.out("trim_start = {}", ts.as_str());
    let te: String = ws.trim_end();
    io.out("trim_end = {}", te.as_str());
    ws.drop(); t.drop(); ts.drop(); te.drop();

    let up: String = String::from("abc");
    let u: String = up.to_upper();
    io.out("to_upper = {}", u.as_str());
    u.drop();
    let low: String = String::from("XYZ");
    let l: String = low.to_lower();
    io.out("to_lower = {}", l.as_str());
    l.drop();
    up.drop(); low.drop();

    let rep: String = String::from("ha");
    let r: String = rep.repeat(3);
    io.out("repeat(3) = {}", r.as_str());
    r.drop(); rep.drop();

    let rpl: String = String::from("aXbXc");
    let rr: String = rpl.replace("X", "-");
    io.out("replace = {}", rr.as_str());
    io.out("count(\"X\") = {}", rpl.count("X"));
    rr.drop(); rpl.drop();

    let tr: String = String::from("abcdefgh");
    tr.truncate(3);
    io.out("truncate(3) = {}", tr.as_str());
    tr.clear();
    io.out("after clear, is_empty = {}", tr.is_empty());
    tr.drop();

    s.ensure(128);
    s.drop();
}
