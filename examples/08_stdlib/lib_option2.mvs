import { io } from "std";
import { Option, Some, None } from "std/option";

func fallback_val() -> i64 { return 42; }
func fallback_opt() -> Option<i64> { return Some(99); }

func main() -> i8 {
    // unwrap_or_else
    let a: Option<i64> = None<i64>();
    io.out("none.unwrap_or_else: {}", a.unwrap_or_else(fallback_val));

    let b: Option<i64> = Some(7);
    io.out("some.unwrap_or_else: {}", b.unwrap_or_else(fallback_val));

    // or_else
    let c: Option<i64> = None<i64>();
    let d: Option<i64> = c.or_else(fallback_opt);
    io.out("none.or_else: {}", d.unwrap());

    let e: Option<i64> = Some(5);
    let f: Option<i64> = e.or_else(fallback_opt);
    io.out("some.or_else: {}", f.unwrap());

    return 0;
}
