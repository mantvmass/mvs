// ============================================================
//  core.mvs — ยูทิลิตีระดับล่างของ vmass (เทียบ zephyr-core)
//
//  นโยบาย: ทำด้วย MVS ล้วนให้มากที่สุด — extern C เฉพาะสิ่งที่ MVS
//  ทำเองไม่ได้ (การจองหน่วยความจำฮีป malloc/memcpy เท่านั้น)
// ============================================================

// extern C: จอง/คืน/คัดลอกฮีป — MVS ยังไม่มี primitive จัดการฮีปในตัวภาษา
extern func malloc(n: usize) -> *u8;
extern func free(p: *u8) -> void;
extern func memcpy(dst: *u8, src: *u8, n: usize) -> *u8;

// ── ด้านล่างนี้เขียนด้วย MVS ล้วน (ไม่พึ่ง C) ──

// ความยาวสตริง (นับไบต์จนเจอ 0) — แทน strlen ด้วย MVS
func str_len(s: str) -> usize {
    let i: usize = 0;
    while (*((s as *u8) + i) != 0) { i = i + 1; }
    return i;
}

// เทียบสตริงเท่ากันไหม (เทียบทีละไบต์) — แทน strcmp==0 ด้วย MVS
func str_eq(a: str, b: str) -> bool {
    let i: usize = 0;
    while (true) {
        let ca: u8 = *((a as *u8) + i);
        let cb: u8 = *((b as *u8) + i);
        if (ca != cb) { return false; }
        if (ca == 0) { return true; }     // จบพร้อมกันและเท่ากันทุกไบต์
        i = i + 1;
    }
    return true;
}

// จอง/คืนหน่วยความจำฮีป — ห่อ malloc/free ไว้ที่เดียว ให้โมดูลอื่นเรียกโดยไม่ต้อง extern C เอง
func alloc(n: usize) -> *u8 { return malloc(n); }
func dealloc(p: *u8) -> void { free(p); }

// คัดช่วงไบต์ [start, start+len) ออกมาเป็นสตริงใหม่ (ปิดท้ายด้วย 0)
// ใช้ malloc/memcpy (extern C) เพราะ MVS จองฮีปเองไม่ได้
func substr(s: str, start: usize, len: usize) -> str {
    let buf: *u8 = malloc(len + 1);
    memcpy(buf, (s as *u8) + start, len);
    *(buf + len) = 0;
    return buf as str;
}
