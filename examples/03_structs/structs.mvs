// ============================================================
//  structs: structs, members, returning a struct, struct literals, io.out on structs
//  build:  mvs.exe examples/03_structs/structs.mvs
//  run:    examples\03_structs\structs.exe
// ============================================================
import { io } from "std";

struct Point { x: i32; y: i32; }

func makePoint(x: i32, y: i32) -> Point { return Point { x: x, y: y }; }

func main() -> i8 {
    let p: Point = Point { x: 3, y: 4 };       // struct literal
    io.out("p = ({}, {})", p.x, p.y);          // (3, 4)
    p.x = 10; p.y += 5;
    io.out("after update: ({}, {})", p.x, p.y); // (10, 9)

    let q: Point = makePoint(7, 8);            // return a struct from a function
    io.out("q = {}", q);                       // q = Point { x: 7, y: 8 }  (io.out can print structs)

    // a struct returned from a function can be used directly as an rvalue
    io.out("makePoint(1,2).x = {}", makePoint(1, 2).x);   // 1
    return 0;
}
