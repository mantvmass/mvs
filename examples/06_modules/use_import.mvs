// ============================================================
//  use_import: importing across files
//  build:  mvs.exe examples/06_modules/use_import.mvs
//  run:    examples\06_modules\use_import.exe
//
//  use forms (the path decides):
//   A) use std::io;                           package submodule -> namespace (io.out)
//   B) use self::mathlib::square;             pulls symbols directly
//   C) use self::mathlib;                     whole module as a namespace (mathlib.square)
//  note: one module binds one namespace per build; pick form B or C per file (do not mix for the same file)
// ============================================================
use std::io;
use self::mathlib::{square, factorial};

func main() -> i8 {
    io.out("square(9) = {}", square(9));            // 81
    io.out("factorial(6) = {}", factorial(6));      // 720
    return 0;
}
