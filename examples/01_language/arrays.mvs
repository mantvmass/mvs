// ============================================================
//  arrays: the real [T; N] array type
//  build:  mvs.exe examples/01_language/arrays.mvs
//  run:    examples\01_language\arrays.exe
//
//  Fixed-size arrays live on the stack (or in .bss for globals), no malloc needed.
//  a[i] reads/writes elements, a.len is the compile-time length, and an array
//  decays to a pointer when passed to a function. Constant indices are bounds
//  checked at compile time.
// ============================================================
import { io } from "std";

struct Point { x: i32; y: i32; }

struct Grid {
    name: str;
    cells: [i32; 4];       // arrays work as struct fields too
}

// arrays decay to pointers at call sites (like C)
func sum(p: *i32, n: i32) -> i32 {
    let total: i32 = 0;
    for (let i: i32 = 0; i < n; i++) {
        total += p[i];      // pointer indexing p[i] = *(p + i)
    }
    return total;
}

// a global array with a literal initializer (stored in .bss, filled at startup)
let squares: [i64; 5] = [1, 4, 9, 16, 25];

func main() -> i8 {
    // literal initialization: the length must match exactly
    let a: [i32; 5] = [10, 20, 30, 40, 50];
    io.out("a = {}", a);                    // [10, 20, 30, 40, 50]
    io.out("a.len = {}", a.len);            // 5

    // element read/write, including compound assignment
    a[0] = 99;
    a[1] += 5;
    io.out("a[0] = {}, a[1] = {}", a[0], a[1]);   // 99, 25

    // computed indices work (only constant ones are bounds checked at compile time)
    let i: i32 = 3;
    io.out("a[i] = {}", a[i]);              // 40

    // uninitialized array: just reserve the space, then fill it
    let fib: [i64; 8] = [0, 1, 0, 0, 0, 0, 0, 0];
    for (let k: i32 = 2; k < 8; k++) {
        fib[k] = fib[k - 1] + fib[k - 2];
    }
    io.out("fib = {}", fib);                // [0, 1, 1, 2, 3, 5, 8, 13]

    // decay to a pointer at a call site
    io.out("sum(a) = {}", sum(a, 5));       // 99+25+30+40+50 = 244

    // arrays of structs
    let pts: [Point; 2] = [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }];
    io.out("pts[1] = {}", pts[1]);          // Point { x: 3, y: 4 }
    pts[0].x = 7;
    io.out("pts[0].x = {}", pts[0].x);      // 7

    // an array inside a struct (printed inline like Rust's {:?})
    let g: Grid = Grid { name: "g1", cells: [0, 0, 0, 0] };
    g.cells[2] = 42;
    io.out("g = {}", g);                    // Grid { name: g1, cells: [0, 0, 42, 0] }

    // globals with literals
    io.out("squares = {}", squares);        // [1, 4, 9, 16, 25]
    return 0;
}
