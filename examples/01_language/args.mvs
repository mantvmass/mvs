// ============================================================
//  args: receive command-line arguments via main's parameters
//  build:  mvs.exe examples/01_language/args.mvs
//  run:    examples\01_language\args.exe 10 32
//
//  Just declare main as  func main(argc: i32, argv: **u8) -> i32
//  The C runtime calls main with argc/argv per the C ABI; argv[i] = *(argv + i) (a C string)
// ============================================================
import { io } from "std";
extern func printf(fmt: str) -> i32;
extern func atoi(s: str) -> i32;

func main(argc: i32, argv: **u8) -> i32 {
    io.out("got {} argument(s):", argc);
    for (let i: i32 = 0; i < argc; i = i + 1) {
        printf("  argv[%d] = %s\n", i, *(argv + i));
    }
    if (argc >= 3) {
        let sum: i32 = atoi(*(argv + 1)) + atoi(*(argv + 2));
        io.out("argv[1] + argv[2] = {}", sum);
    }
    return 0;
}
