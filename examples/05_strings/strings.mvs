// ============================================================
//  strings: the String type (heap, owned) from std/string.mvs
//  build:  mvs.exe examples/05_strings/strings.mvs
//  run:    examples\05_strings\strings.exe
//
//  str    = pointer to constant text (read-only, uses "")
//  String = heap buffer, appendable/mutable, must be drop()ed manually (no GC)
// ============================================================
import { io } from "std";
import { String } from "std/string";

func main() -> i8 {
    let s: String = String::from("hello");                 // build from a str (copied to the heap)
    io.out("s = {} (len {})", s.as_str(), s.len());        // hello (len 5)

    s.push_str(", world").push_str("!");                   // append text (chainable)
    io.out("joined = {} (len {})", s.as_str(), s.len());   // hello, world! (len 13)

    let n: String = String::from_int(2026);                // build from an integer
    io.out("year = {}", n.as_str());                       // 2026

    s.drop(); n.drop();                                    // free the memory when done
    return 0;
}
