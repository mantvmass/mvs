// ============================================================
//  use_import: importing across files
//  build:  mvs.exe examples/06_modules/use_import.mvs
//  run:    examples\06_modules\use_import.exe
//
//  import forms (the path decides):
//   A) import { io } from "std"               package submodule -> namespace (io.out)
//   B) import { square } from "./mathlib.mvs" pulls symbols directly
//   C) import m from "./mathlib.mvs"          whole module as a namespace (m.square), see note
//  note: one module binds one namespace per build; pick form B or C per file (do not mix for the same file)
// ============================================================
import { io } from "std";                          // A
import { square, factorial } from "./mathlib.mvs"; // B

func main() -> i8 {
    io.out("square(9) = {}", square(9));            // 81
    io.out("factorial(6) = {}", factorial(6));      // 720
    return 0;
}
