// generic structs: struct Vec<T> templates, monomorphized per concrete use
// (methods come along; nested generics like Boxed<Pair<i64, i64>> work too)
import { io } from "std";

struct Pair<T, U> {
    a: T;
    b: U;
}

impl Pair<T, U> {
    func first(self: *Pair<T, U>) -> T { return self.a; }
    func second(self: *Pair<T, U>) -> U { return self.b; }
}

struct Boxed<T> {
    val: T;
}

impl Boxed<T> {
    func get(self: *Boxed<T>) -> T { return self.val; }
    func set(self: *Boxed<T>, v: T) -> void { self.val = v; }
}

func main() -> i8 {
    let p: Pair<i64, str> = Pair<i64, str> { a: 42, b: "hello" };
    io.out("first = {}", p.first());
    io.out("second = {}", p.second());

    let q: Pair<f64, i32> = Pair<f64, i32> { a: 1.5, b: 7 };
    io.out("q = {} {}", q.first(), q.second());

    let bx: Boxed<i64> = Boxed<i64> { val: 10 };
    bx.set(99);
    io.out("boxed = {}", bx.get());

    // nested generic: a box of a pair
    let nb: Boxed<Pair<i64, i64>> = Boxed<Pair<i64, i64>> { val: Pair<i64, i64> { a: 1, b: 2 } };
    io.out("nested = {}", nb.val.a + nb.val.b);
    return 0;
}
