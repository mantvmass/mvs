/*
 * std/net.mvs - the net (TCP networking) module, Rust style: struct + method
 *
 * Uses Windows Winsock2 (the compiler links ws2_32 automatically)
 * Status: experimental. The structures and Winsock calls are complete,
 *         but real testing needs a server/client on the other end.
 *
 * Example (client):
 *     import { net } from "std";
 *     let conn = net.TcpClient("93.184.216.34", 80);
 *     conn.send("GET / HTTP/1.0\r\n\r\n");
 *     let reply = conn.recv();
 *     conn.close();
 *
 * Example (server):
 *     let server = net.TcpServer("0.0.0.0", 8080);
 *     let conn = server.accept();
 *     conn.send("hello");
 *     conn.close();
 *     server.close();
 */

// IPv4 destination address structure (matches Winsock's sockaddr_in, 16 bytes)
struct sockaddr_in {
    family: u16;   // AF_INET = 2
    port: u16;     // port number (network byte order)
    addr: u32;     // IP address (network byte order)
    zero: u64;     // 8 bytes of padding
}

// a connected socket (used to send and receive data)
struct TcpSocket {
    fd: usize;     // socket handle
}

// a server that is currently listening
struct TcpServer {
    fd: usize;     // listening socket handle
}

// --- foreign functions from Winsock (ws2_32) and the C runtime ---
extern func WSAStartup(version: u16, data: *u8) -> i32;
extern func socket(family: i32, kind: i32, protocol: i32) -> usize;
extern func connect(s: usize, addr: *u8, addrlen: i32) -> i32;
extern func bind(s: usize, addr: *u8, addrlen: i32) -> i32;
extern func listen(s: usize, backlog: i32) -> i32;
extern func accept(s: usize, addr: *u8, addrlen: *u8) -> usize;
extern func send(s: usize, buf: str, len: i32, flags: i32) -> i32;
extern func recv(s: usize, buf: *u8, len: i32, flags: i32) -> i32;
extern func closesocket(s: usize) -> i32;
extern func htons(value: u16) -> u16;
extern func inet_addr(ip: str) -> u32;
extern func strlen(s: str) -> usize;
extern func malloc(n: usize) -> *u8;

// initialize Winsock (safe to call repeatedly)
func startup() -> i32 {
    let data: *u8 = malloc(512);   // WSADATA buffer
    return WSAStartup(514, data);  // 514 = 0x0202 = version 2.2
}

// --- TcpSocket methods ---
impl TcpSocket {
    // send data (a string); returns the number of bytes sent
    func send(self: *TcpSocket, data: str) -> i32 {
        return send(self.fd, data, strlen(data), 0);
    }
    // receive data (up to ~4095 bytes); returns a zero-terminated string
    func recv(self: *TcpSocket) -> str {
        let buf: *u8 = malloc(4096);
        let n: i32 = recv(self.fd, buf, 4095, 0);
        if (n < 0) { n = 0; }
        *(buf + n) = 0;
        return buf;
    }
    // close the socket
    func close(self: *TcpSocket) -> i32 {
        return closesocket(self.fd);
    }
}

// --- TcpServer methods ---
impl TcpServer {
    // wait for a connection; returns the client's TcpSocket
    func accept(self: *TcpServer) -> TcpSocket {
        let cfd: usize = accept(self.fd, 0, 0);
        return TcpSocket { fd: cfd };
    }
    // close the server
    func close(self: *TcpServer) -> i32 {
        return closesocket(self.fd);
    }
}

// --- constructors ---

// open a TCP connection to ip:port; returns a TcpSocket
func TcpClient(ip: str, port: u16) -> TcpSocket {
    startup();
    let fd: usize = socket(2, 1, 6);  // AF_INET=2, SOCK_STREAM=1, IPPROTO_TCP=6
    let sa: sockaddr_in;
    sa.family = 2;
    sa.port = htons(port);
    sa.addr = inet_addr(ip);
    sa.zero = 0;
    connect(fd, &sa, 16);
    return TcpSocket { fd: fd };
}

// create a server that binds + listens at ip:port; returns a TcpServer
func TcpServer(ip: str, port: u16) -> TcpServer {
    startup();
    let fd: usize = socket(2, 1, 6);
    let sa: sockaddr_in;
    sa.family = 2;
    sa.port = htons(port);
    sa.addr = inet_addr(ip);
    sa.zero = 0;
    bind(fd, &sa, 16);
    listen(fd, 16);
    return TcpServer { fd: fd };
}
