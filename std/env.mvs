/*
 * std/env.mvs - environment variables and command-line arguments
 *
 * get() is plain C getenv; set() differs per OS (_putenv_s vs setenv) and is
 * selected with @compile.
 *
 * Example:
 *     use std::{io, env};
 *     env.set("MODE", "debug");
 *     io.out("MODE = {}", env.get("MODE"));
 *
 *     let a: Vec<String> = env.args();
 *     io.out("argv[0] = {}", a.get(0).as_str());
 */
use std::vec::Vec;
use std::string::String;

extern func getenv(name: str) -> *u8;
extern func malloc(n: usize) -> *u8;
extern func free(p: *u8) -> void;
extern func strlen(s: str) -> usize;

@compile(target_os = "windows")
extern func _putenv_s(name: str, value: str) -> i32;
@compile(target_os = "linux")
extern func setenv(name: str, value: str, overwrite: i32) -> i32;

// the variable's value, or "" when it is not set
func get(name: str) -> str {
    let v: *u8 = getenv(name);
    if (v == 0) { return ""; }
    return v as str;
}

// set (or overwrite) a variable for this process; returns 0 on success
@compile(target_os = "windows")
func set(name: str, value: str) -> i32 {
    return _putenv_s(name, value);
}
@compile(target_os = "linux")
func set(name: str, value: str) -> i32 {
    return setenv(name, value, 1);
}

// command-line arguments as a Vec of Strings

@compile(target_os = "linux")
extern func fopen(path: str, mode: str) -> *u8;
@compile(target_os = "linux")
extern func fread(buf: *u8, size: usize, count: usize, stream: *u8) -> usize;
@compile(target_os = "linux")
extern func fclose(stream: *u8) -> i32;

@compile(target_os = "linux")
func args() -> Vec<String> {
    let out: Vec<String> = Vec<String>::new();
    let f: *u8 = fopen("/proc/self/cmdline", "rb");
    if (f == 0) { return out; }
    let buf: *u8 = malloc(65536);
    let n: usize = fread(buf, 1, 65536, f);
    fclose(f);
    let i: usize = 0;
    while (i < n) {
        let arg: str = (buf + i) as str;
        let alen: usize = strlen(arg);
        if (alen > 0) {
            out.push(String::from(arg));
        }
        i = i + alen + 1;
    }
    free(buf);
    return out;
}

@compile(target_os = "windows")
extern func GetCommandLineA() -> str;

@compile(target_os = "windows")
func args() -> Vec<String> {
    let out: Vec<String> = Vec<String>::new();
    let cmd: str = GetCommandLineA();
    let p: *u8 = cmd as *u8;
    let n: usize = strlen(cmd);
    let i: usize = 0;
    while (i < n) {
        while (i < n && (p[i] == 32 || p[i] == 9)) { i = i + 1; }
        if (i < n) {
            let arg: String = String::new();
            if (p[i] == 34) {
                i = i + 1;
                while (i < n && p[i] != 34) {
                    arg.push_char(p[i] as char);
                    i = i + 1;
                }
                if (i < n) { i = i + 1; }
            } else {
                while (i < n && p[i] != 32 && p[i] != 9) {
                    arg.push_char(p[i] as char);
                    i = i + 1;
                }
            }
            out.push(arg);
        }
    }
    return out;
}
