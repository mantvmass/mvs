/*
 * std/http/util.mvs - string helpers and byte constants for the HTTP module
 */
use std::mem;
use core::cstr;

const SP: u8 = 32;
const CR: u8 = 13;
const LF: u8 = 10;
const COLON: u8 = 58;
const STAR: u8 = 42;
const SLASH: u8 = 47;

func slice(s: str, start: i64, end: i64) -> str {
    if (end < start) { end = start; }
    let n: i64 = end - start;
    let p: *u8 = s as *u8;
    let buf: *u8 = mem.alloc((n + 1) as usize);
    let i: i64 = 0;
    while (i < n) {
        buf[i as usize] = p[(start + i) as usize];
        i = i + 1;
    }
    buf[n as usize] = 0;
    return buf as str;
}

func index_of(s: str, b: u8, from: i64) -> i64 {
    let p: *u8 = s as *u8;
    let n: i64 = cstr.len(s) as i64;
    let i: i64 = from;
    while (i < n) {
        if (p[i as usize] == b) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

func header_end(s: str) -> i64 {
    let p: *u8 = s as *u8;
    let n: i64 = cstr.len(s) as i64;
    let i: i64 = 0;
    while (i + 3 < n) {
        if (p[i as usize] == CR && p[(i + 1) as usize] == LF &&
            p[(i + 2) as usize] == CR && p[(i + 3) as usize] == LF) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

func lower(s: str) -> str {
    let n: i64 = cstr.len(s) as i64;
    let p: *u8 = s as *u8;
    let buf: *u8 = mem.alloc((n + 1) as usize);
    let i: i64 = 0;
    while (i < n) {
        let c: u8 = p[i as usize];
        if (c >= 65 && c <= 90) { c = c + 32; }
        buf[i as usize] = c;
        i = i + 1;
    }
    buf[n as usize] = 0;
    return buf as str;
}

func is_space(c: u8) -> bool { return c == SP || c == 9; }

func trim(s: str) -> str {
    let n: i64 = cstr.len(s) as i64;
    let p: *u8 = s as *u8;
    let a: i64 = 0;
    while (a < n && is_space(p[a as usize])) { a = a + 1; }
    let b: i64 = n;
    while (b > a && is_space(p[(b - 1) as usize])) { b = b - 1; }
    return slice(s, a, b);
}

func to_int(s: str) -> i64 {
    let n: i64 = cstr.len(s) as i64;
    let p: *u8 = s as *u8;
    let i: i64 = 0;
    let v: i64 = 0;
    let any: bool = false;
    while (i < n && p[i as usize] >= 48 && p[i as usize] <= 57) {
        v = v * 10 + ((p[i as usize] - 48) as i64);
        any = true;
        i = i + 1;
    }
    if (!any) { return 0 - 1; }
    return v;
}

func hex_val(c: u8) -> i64 {
    if (c >= 48 && c <= 57) { return (c - 48) as i64; }
    if (c >= 97 && c <= 102) { return (c - 97 + 10) as i64; }
    if (c >= 65 && c <= 70) { return (c - 65 + 10) as i64; }
    return 0 - 1;
}

func url_decode(s: str) -> str {
    let n: i64 = cstr.len(s) as i64;
    let p: *u8 = s as *u8;
    let buf: *u8 = mem.alloc((n + 1) as usize);
    let i: i64 = 0;
    let o: i64 = 0;
    while (i < n) {
        let c: u8 = p[i as usize];
        if (c == 37 && i + 2 < n) {
            let hi: i64 = hex_val(p[(i + 1) as usize]);
            let lo: i64 = hex_val(p[(i + 2) as usize]);
            if (hi >= 0 && lo >= 0) {
                buf[o as usize] = (hi * 16 + lo) as u8;
                o = o + 1;
                i = i + 3;
            } else {
                buf[o as usize] = c; o = o + 1; i = i + 1;
            }
        } else if (c == 43) {
            buf[o as usize] = SP; o = o + 1; i = i + 1;
        } else {
            buf[o as usize] = c; o = o + 1; i = i + 1;
        }
    }
    buf[o as usize] = 0;
    return buf as str;
}
