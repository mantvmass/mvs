/*
 * std/sort.mvs - sorting algorithms for Vec<T>
 *
 * Usage:
 *     import { sort } from "std";
 *     import { Vec } from "std/vec";
 *     let v: Vec<i64> = Vec<i64>::new();
 *     v.push(3); v.push(1); v.push(2);
 *     sort.ascending(v.as_ptr(), v.len());   // [1, 2, 3]
 *     sort.descending(v.as_ptr(), v.len());  // [3, 2, 1]
 *
 * The sort functions take a *T and a count, so they work with both Vec and
 * plain arrays (pass the array and its length). The generic T must support
 * comparison operators (< >); the compiler checks this at instantiation.
 *
 * Algorithm: insertion sort, which is fast enough for typical collections and
 * simple to implement without recursion or function pointers to a comparator.
 */

// sort n elements at p in ascending order (smallest first)
func ascending<T>(p: *T, n: usize) -> void {
    if (n < 2) { return; }
    let i: usize = 1;
    while (i < n) {
        let key: T = p[i];
        let j: i64 = i as i64 - 1;
        while (j >= 0 && p[j as usize] > key) {
            p[(j + 1) as usize] = p[j as usize];
            j = j - 1;
        }
        p[(j + 1) as usize] = key;
        i = i + 1;
    }
}

// sort n elements at p in descending order (largest first)
func descending<T>(p: *T, n: usize) -> void {
    if (n < 2) { return; }
    let i: usize = 1;
    while (i < n) {
        let key: T = p[i];
        let j: i64 = i as i64 - 1;
        while (j >= 0 && p[j as usize] < key) {
            p[(j + 1) as usize] = p[j as usize];
            j = j - 1;
        }
        p[(j + 1) as usize] = key;
        i = i + 1;
    }
}

// is the array sorted in ascending order?
func is_sorted<T>(p: *T, n: usize) -> bool {
    if (n < 2) { return true; }
    let i: usize = 1;
    while (i < n) {
        if (p[i] < p[i - 1]) { return false; }
        i = i + 1;
    }
    return true;
}
