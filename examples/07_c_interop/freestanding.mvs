// ============================================================
//  freestanding: low-level code with no std/CRT/OS dependency (OS dev/bare-metal)
//  build:  mvs.exe examples/07_c_interop/freestanding.mvs --nostd
//          -> yields freestanding.obj (no C runtime dependency) to link/embed yourself
//
//  note: in --nostd mode io.out / import std are unavailable (no OS to rely on)
// ============================================================

struct Color { r: u8; g: u8; b: u8; }
impl Color { func luminance(self: *Color) -> i64 { return self.r + self.g + self.b; } }

// write/read memory directly (e.g. the VGA text buffer 0xB8000)
export func poke(addr: *u8, value: u8) -> void { *addr = value; }
export func peek(addr: *u8) -> u8 { return *addr; }

// demonstrate struct + method in freestanding mode
export func brightness(r: u8, g: u8, b: u8) -> i64 {
    let c: Color = Color { r: r, g: g, b: b };
    return c.luminance();
}
