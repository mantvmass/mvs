// ============================================================
//  casts: type conversion with `as` + compile-time type checking
//  build:  mvs.exe examples/01_language/casts.mvs
//  run:    examples\01_language\casts.exe
//
//  This language refuses sloppy typing: 50 + "50" is a compile-time error
//  To really convert, use `as` (binds tighter than arithmetic operators)
// ============================================================
import { io } from "std";

func main() -> i8 {
    let a: i32 = 7;
    io.out("7 as f64 / 2.0 = {}", a as f64 / 2.0);   // 3.5  (without the cast: 7/2 = 3)
    io.out("3.9 as i32 = {}", 3.9 as i32);           // 3    (fraction discarded)
    io.out("300 as u8 = {}", 300 as u8);             // 44   (300 mod 256)
    io.out("255 (u8) as i8 = {}", 255 as u8 as i8);  // -1   (bits reinterpreted)
    io.out("65 as char = {}", 65 as char);           // A
    io.out("a as i32 * 2 = {}", a as i32 * 2);       // 14   (= (a as i32) * 2)

    // implicit: int -> float at an assignment boundary happens automatically
    let f: f64 = 5;                                   // 5.0
    io.out("let f64 = 5 -> {}", f);
    return 0;
}
